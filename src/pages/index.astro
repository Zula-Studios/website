---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { iso, processIcons } from '@/data/visuals';
import { projekte } from '@/data/projekte';
import { localBusinessSchema, faqPageSchema } from '@/lib/schema';

const faqs = [
  {
    q: 'Wie lange dauert eine Shopify Migration?',
    a: 'Typischerweise 2–8 Wochen – abhängig von Datenmenge, Komplexität und Quellsystem. Wir garantieren Datensicherheit und minimale Unterbrechung.',
  },
  {
    q: 'Bietet ihr Support nach dem Launch an?',
    a: 'Ja. Jedes Projekt beinhaltet 30 Tage kostenlosen Post-Launch-Support. Darüber hinaus bieten wir flexible Retainer-Pakete für laufende Betreuung.',
  },
  {
    q: 'Arbeitet ihr nur in Hamburg oder auch remote?',
    a: 'Unser Studio sitzt in Hamburg. Projekte betreuen wir vor Ort und remote für Kunden in ganz Deutschland – mit klaren Jour-Fixes und transparentem Fortschritt.',
  },
  {
    q: 'Arbeitet ihr auch mit bestehenden Shopify-Shops?',
    a: 'Absolut. Wir übernehmen Optimierungen, Redesigns, App-Entwicklung und Performance-Audits für Shopify-Shops jeder Größe.',
  },
];

const featuredCases = projekte.filter(p => p.featured).slice(0, 4);
const caseStrip = featuredCases.length >= 3 ? featuredCases : projekte.slice(0, 4);

const units = [
  {
    title: 'Shopify',
    desc: 'Shops, die verkaufen — Custom Themes, Conversion und Launch aus einer Hand.',
    href: '/leistungen/shopify-shop-erstellen',
    icon: '/images/units/unit-shopify.jpg',
  },
  {
    title: 'Migration',
    desc: 'WooCommerce, Magento & Co. zu Shopify — sicher, SEO-neutral, ohne Drama.',
    href: '/leistungen/shopify-migration',
    icon: '/images/units/unit-migration.jpg',
  },
  {
    title: 'Astro & Web',
    desc: 'Schnelle Unternehmenswebsites und Landingpages mit Astro.js.',
    href: '/leistungen/astro-websites',
    icon: '/images/units/unit-astro.jpg',
  },
  {
    title: 'Laravel',
    desc: 'Custom Apps, CRMs und APIs — wenn Standard-Shops nicht reichen.',
    href: '/leistungen/individuelle-entwicklung',
    icon: '/images/units/unit-laravel.jpg',
  },
];

const processSteps = [
  { n: '01', title: 'Analyse', desc: 'Business, Ziele und technischer Status — klar vor dem ersten Commit.' },
  { n: '02', title: 'Konzept', desc: 'Wireframes, Architektur und Roadmap, bevor Code geschrieben wird.' },
  { n: '03', title: 'Entwicklung', desc: 'Agil, mit wöchentlichen Updates. Sie sehen den Fortschritt live.' },
  { n: '04', title: 'Launch', desc: 'Sauberer Go-Live und Support weit über den Launch hinaus.' },
];

const clientNames = [...new Set(projekte.map(p => p.client))];

const pageSchema = [
  localBusinessSchema({
    serviceType: ['Shopify Development', 'E-Commerce', 'Web Development', 'Laravel Development'],
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="Shopify Agentur Hamburg – Shops, Migration & Web"
  description="Zula Studios ist Ihre Shopify Agentur in Hamburg: Custom Shops, Migrationen, Astro-Websites und Laravel-Apps. 10+ Projekte. Kostenloses Erstgespräch."
  schema={pageSchema}
  darkHero={false}
  keywords={['Shopify Agentur Hamburg', 'Shopify Shop erstellen', 'Shopify Migration', 'Astro Website Hamburg', 'Webentwicklung Hamburg']}
>

  <DarkHero
    title="Wir sind"
    accent="Zula Studios."
    image="/images/heroes/hero-home.png"
    imageWidth={733}
    imageHeight={724}
  >
    <p>Eure Partner für Shopify, Astro und Laravel in Hamburg — Shops, Migrationen und Websites, die performen.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]">Angebot anfordern</a>
      <a href="/referenzen" class="btn btn-ghost py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Cases ansehen</a>
    </div>
    <div class="mt-8 flex flex-wrap gap-2">
      {[
        { value: '10+', label: 'Projekte live' },
        { value: 'HH', label: 'Studio Hamburg' },
        { value: '10+ J.', label: 'Erfahrung' },
        { value: '30 T.', label: 'Launch-Support' },
      ].map(s => (
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-white/15 text-[12px] text-white/75">
          <span class="font-bold text-white">{s.value}</span>
          {s.label}
        </span>
      ))}
    </div>
  </DarkHero>

  <!-- CLIENTS -->
  <div class="bg-white border-b border-[#E4E6EB] py-4 overflow-hidden" aria-label="Kunden">
    <div class="marquee-track">
      {[...clientNames, ...clientNames].map(name => (
        <span class="flex items-center gap-6 px-7 text-[#AEAEB5] text-sm font-semibold tracking-[0.08em] uppercase whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-[#00F573] shrink-0"></span>
          {name}
        </span>
      ))}
    </div>
  </div>

  <!-- INTRO -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-12 lg:gap-20 items-start">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">Shopify Agentur Hamburg</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] mb-5" style="font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05;">
            Technik, Design und Conversion — aus einer Hand.
          </h2>
          <p class="text-[#62626E] text-base lg:text-lg leading-relaxed mb-4 max-w-xl">
            Bei Zula Studios sitzen Shop-Entwicklung, Astro-Frontends und Laravel-Backends im selben Team. Kein Agentur-Pingpong — klare Verantwortung und messbare Outcomes.
          </p>
          <p class="text-[#88888F] text-[15px] leading-relaxed max-w-xl mb-8">
            Für Marken in Hamburg und remote in ganz Deutschland.
          </p>
          <a href="/ueber-uns" class="btn btn-primary uppercase tracking-[0.04em] text-[13px]">Über uns</a>
        </div>
        <div class="grid grid-cols-2 gap-3" data-reveal data-delay="2">
          {[
            { value: '100%', label: 'Fokus auf Ergebnis' },
            { value: '0', label: 'Downtime-Ziel' },
            { value: 'HH', label: 'Studio Hamburg' },
            { value: '30', label: 'Tage Support' },
          ].map(s => (
            <div class="rounded-2xl border border-[#E4E6EB] bg-[#F4F5F7] p-5">
              <div class="font-bold text-[#0A0A0C] text-2xl tracking-[-0.03em] mb-1">{s.value}</div>
              <div class="text-[13px] font-semibold text-[#62626E]">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- UNITS -->
  <section class="py-20 lg:py-28 bg-[#F4F5F7] relative overflow-hidden">
    <div class="container relative z-10">
      <div class="text-center mb-12 lg:mb-16" data-reveal>
        <SectionLabel tone="emerald" class="mb-3 justify-center">Expertise</SectionLabel>
        <h2
          class="font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em]"
          style="font-size: clamp(1.85rem, 4.5vw, 3.25rem); line-height: 1.05;"
        >
          Vier Disziplinen.<br class="sm:hidden" /> Ein Studio.
        </h2>
        <p class="mt-4 text-[#62626E] text-[15px] max-w-lg mx-auto leading-relaxed">
          Shopify, Migration, Astro und Laravel — alles aus einem Team in Hamburg.
        </p>
      </div>

      <div class="units-grid relative grid grid-cols-1 sm:grid-cols-2 gap-5 lg:gap-8 max-w-4xl mx-auto">
        {/* Dashed connectors (desktop) */}
        <svg class="pointer-events-none absolute inset-0 hidden sm:block w-full h-full" aria-hidden="true" preserveAspectRatio="none">
          <line x1="50%" y1="8%" x2="50%" y2="92%" stroke="#00F573" stroke-width="2" stroke-dasharray="6 8" opacity="0.55" />
          <line x1="8%" y1="50%" x2="92%" y2="50%" stroke="#00F573" stroke-width="2" stroke-dasharray="6 8" opacity="0.55" />
        </svg>

        {units.map((u, i) => (
          <a
            href={u.href}
            class="group relative z-10 rounded-2xl border border-[#E4E6EB] bg-white p-6 lg:p-8 text-center hover:border-[#00F573]/55 hover:shadow-[0_12px_32px_rgba(0,0,0,0.06)] transition-all duration-200"
            data-reveal
            data-delay={String(i + 1)}
          >
            <div class="mx-auto mb-5 w-[140px] h-[140px] lg:w-[160px] lg:h-[160px] flex items-center justify-center">
              <img
                src={u.icon}
                alt=""
                width="320"
                height="320"
                class="w-full h-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 class="font-extrabold italic uppercase text-[#0A0A0C] text-lg lg:text-xl tracking-[-0.02em] mb-3 group-hover:text-[#00C45C] transition-colors">
              {u.title}
            </h3>
            <p class="text-[#62626E] text-[14px] leading-relaxed mb-5 max-w-xs mx-auto">{u.desc}</p>
            <span class="inline-flex items-center gap-2 text-[12px] font-bold uppercase tracking-[0.08em] text-[#00C45C]">
              Mehr Infos
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center" data-reveal>
        <a href="/leistungen" class="btn btn-primary uppercase tracking-[0.05em] text-[13px]">
          Alle Leistungen
        </a>
      </div>
    </div>
  </section>

  <!-- CASES -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 lg:mb-14" data-reveal>
        <div>
          <SectionLabel tone="emerald" class="mb-3">Referenzen</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05;">
            Richtig gute Projekte.
          </h2>
        </div>
        <a href="/referenzen" class="inline-flex items-center gap-2 text-[13px] font-bold uppercase tracking-[0.06em] text-[#00C45C] hover:underline">
          Alle ansehen →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
        {caseStrip.map((p, i) => (
          <a
            href={`/referenzen/${p.slug}`}
            class="group flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-[#F4F5F7] hover:border-[#00F573]/50 transition-all min-h-[240px]"
            data-reveal
            data-delay={String(i + 1)}
          >
            <div class="flex-1 p-6 lg:p-7 flex flex-col">
              <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#00C45C] mb-3">
                {p.service} · {p.jahr}
              </p>
              <h3 class="font-bold text-[#0A0A0C] text-xl lg:text-2xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                {p.client}
              </h3>
              <p class="text-[#62626E] text-[14px] leading-snug max-w-sm mb-auto line-clamp-2">
                {p.tagline}
              </p>
            </div>
            <div class="flex items-center justify-between px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D]">
              <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="py-20 lg:py-28 bg-[#F4F5F7]">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 items-start">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">Warum Zula</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] mb-6" style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05;">
            Kein Agentur-Bingo.<br/>Nur Ergebnisse.
          </h2>
          <p class="text-[#62626E] leading-relaxed text-base lg:text-lg mb-8 max-w-sm">
            Transparent, pünktlich, unternehmerisch. Kleines Kernteam — tiefe Shopify- und Astro-Expertise ohne Overhead.
          </p>
          <a href="/ueber-uns" class="btn btn-outline inline-flex uppercase tracking-[0.04em] text-[13px]">Über uns</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { icon: iso.target, title: 'Ergebnisorientiert', desc: 'Jede Entscheidung zielt auf Conversion, Leads und Umsatz.' },
            { icon: iso.plan, title: 'Transparent', desc: 'Keine versteckten Kosten. Klare Kommunikation, immer.' },
            { icon: iso.code, title: 'Technisch tief', desc: 'Shopify, Astro, Laravel — APIs, Themes, Integrationen.' },
            { icon: iso.talk, title: 'Partnerschaftlich', desc: 'Wir denken mit, hinterfragen und empfehlen ehrlich.' },
          ].map((item, i) => (
            <div class="p-6 rounded-2xl border border-[#E4E6EB] bg-white hover:border-[#00F573]/40 transition-all" data-reveal data-delay={String(i + 1)}>
              <div class="mb-4">
                <IsoIcon src={item.icon} />
              </div>
              <h3 class="font-semibold text-[#0A0A0C] text-[15px] mb-2">{item.title}</h3>
              <p class="text-[#88888F] text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">Prozess</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] mb-6" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
            Von der Idee zum<br/>fertigen Launch
          </h2>
        </div>
        <div class="space-y-0">
          {processSteps.map((step, i) => (
            <div class:list={['flex gap-5 sm:gap-8 py-6 border-b border-[#E4E6EB]', i === 0 ? 'border-t' : '']} data-reveal data-delay={String(i + 1)}>
              <IsoIcon src={processIcons[i]} size="sm" />
              <span class="text-xs font-bold text-[#00F573] tabular-nums shrink-0 mt-1 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0A0A0C] text-base mb-2">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 lg:py-28 bg-[#F4F5F7]">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">FAQ</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
            Häufige Fragen
          </h2>
          <a href={`mailto:${SITE.email}`} class="btn btn-outline inline-flex text-sm mt-4">{SITE.email}</a>
        </div>
        <div class="space-y-2" data-reveal data-delay="2">
          {faqs.map(faq => (
            <details class="group bg-white rounded-2xl border border-[#E4E6EB] hover:border-[#00F573]/40 transition-colors overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 font-semibold text-[#0A0A0C] text-[15px] cursor-pointer select-none">
                {faq.q}
                <span class="w-6 h-6 rounded-full border border-[#E4E6EB] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 group-open:border-[#00F573] group-open:text-[#00C45C] transition-all">
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </span>
              </summary>
              <div class="px-6 pb-5 text-[#62626E] text-sm leading-relaxed border-t border-[#E4E6EB] pt-4">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- JOBS -->
  <section class="py-16 lg:py-20 bg-white border-y border-[#E4E6EB]">
    <div class="container flex flex-col sm:flex-row sm:items-center justify-between gap-6" data-reveal>
      <div>
        <p class="text-[11px] font-bold tracking-[0.16em] uppercase text-[#00C45C] mb-2">Karriere</p>
        <h2 class="font-bold text-[#0A0A0C] text-xl lg:text-2xl tracking-[-0.02em] mb-1">Wir suchen — du findest.</h2>
        <p class="text-[#88888F] text-[14px]">Shopify, Astro & Laravel — remote-first, Basis Hamburg.</p>
      </div>
      <a href="/karriere" class="btn btn-primary shrink-0 uppercase tracking-[0.04em] text-[13px]">Offene Stellen</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden bg-[#F4F5F7] py-20 lg:py-28 border-t border-[#E4E6EB]">
    <div class="pointer-events-none absolute left-1/2 top-0 h-72 w-[42rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-[#00F573]/20 blur-3xl" aria-hidden="true"></div>
    <div class="container relative max-w-2xl text-center">
      <img
        src="/images/body/body-launch.jpg"
        alt=""
        width="160"
        height="160"
        class="mx-auto mb-6 h-28 w-28 object-contain"
        loading="lazy"
        decoding="async"
      />
      <h2 class="font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em] mb-5" style="font-size: clamp(2rem, 5vw, 3.25rem); line-height: 0.95;" data-reveal>
        Bereit für den<br />
        <span class="text-[#00C45C]">nächsten Launch?</span>
      </h2>
      <p class="text-[#62626E] text-base lg:text-lg mb-10" data-reveal data-delay="1">
        Kostenloses Erstgespräch in Hamburg oder remote.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3" data-reveal data-delay="2">
        <a href="/projekt-starten" class="btn btn-primary w-full sm:w-auto py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]">Angebot anfordern</a>
        <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="btn btn-outline w-full sm:w-auto py-3.5 px-7 text-[14px]">{SITE.phone}</a>
      </div>
    </div>
  </section>

</BaseLayout>

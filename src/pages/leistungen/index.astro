---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { SITE } from '@/config/site';
import { servicesByCategory, serviceHref } from '@/data/services';

// Fortlaufende Nummerierung über alle Kategorien hinweg
let counter = 0;
const groups = servicesByCategory.map(g => ({
  ...g,
  items: g.items.map(s => ({ ...s, num: String(++counter).padStart(2, '0'), href: serviceHref(s) })),
}));
const services = groups.flatMap(g => g.items);
const showCategoryHeadings = groups.length > 1;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Leistungen – Zula Studios Hamburg',
  description:
    'Shopify-Shops, Migrationen, Landingpages, individuelle Webentwicklung und KI-Lösungen aus Hamburg.',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    url: `${SITE.url}${s.href}`,
    description: s.desc,
  })),
};
---

<BaseLayout
  title="Leistungen: Shopify, KI & Webentwicklung Hamburg"
  description="Shopify Agentur Hamburg: Shops, Migrationen, Landingpages, Custom Development und KI-Lösungen – bundesweit remote. Kostenloses Erstgespräch vereinbaren."
  schema={itemListSchema}
  darkHero={false}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Leistungen', url: '/leistungen' }]}
>
  <DarkHero
    title="Leistungen"
    accent="aus einer Hand."
    image="/images/heroes/hero-services.png"
    imageWidth={760}
    imageHeight={700}
    seo="Leistungen: Shopify, KI und Webentwicklung in Hamburg. "
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen' }]}
  >
    <p>Shopify-Shops, Migrationen, individuelle Entwicklung und KI-Lösungen — für Unternehmen in Hamburg und bundesweit remote.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary text-[13px] uppercase tracking-[0.05em]">Projekt anfragen</a>
    </div>
  </DarkHero>

  <!-- Services -->
  <section class="py-20 lg:py-24 bg-white">
    {groups.map((g, gi) => (
      <div class:list={['container', showCategoryHeadings && gi > 0 && 'mt-20 lg:mt-24']} id={showCategoryHeadings ? g.category.id : undefined}>
        {showCategoryHeadings && (
          <div class="mb-10 lg:mb-12" data-reveal>
            <SectionLabel tone="emerald" class="mb-3">{g.category.label}</SectionLabel>
            <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-3" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
              {g.category.title}
            </h2>
            <p class="text-[#62626E] text-base leading-relaxed max-w-xl">{g.category.desc}</p>
          </div>
        )}
        <div class="space-y-0 border-t border-[#EBEBEF]">
          {g.items.map(s => (
            <div class="grid grid-cols-1 lg:grid-cols-[auto_auto_1fr_auto] gap-6 lg:gap-12 py-10 lg:py-14 border-b border-[#EBEBEF] items-start group" data-reveal>
              <IsoIcon src={s.image} />
              <span class="text-xs font-bold text-[#00F573] tabular-nums pt-1">{s.num}</span>
              <div>
                {showCategoryHeadings ? (
                  <h3 class="font-bold text-[#0C0C0F] text-2xl lg:text-3xl tracking-[-0.02em] mb-3">{s.title}</h3>
                ) : (
                  <h2 class="font-bold text-[#0C0C0F] text-2xl lg:text-3xl tracking-[-0.02em] mb-3">{s.title}</h2>
                )}
                <p class="text-[#62626E] text-base leading-relaxed mb-6 max-w-xl">{s.desc}</p>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {s.features.map(f => (
                    <li class="flex items-center gap-2.5 text-sm text-[#44444F]">
                      <svg width="12" height="12" viewBox="0 0 14 14" fill="none" class="text-accent-500 shrink-0">
                        <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="lg:pt-1">
                <a href={s.href} class="btn btn-primary whitespace-nowrap">
                  {s.cta}
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <!-- CTA -->
  <section class="py-20 lg:py-28 bg-[#F4F5F7] border-t border-[#E4E6EB]">
    <div class="container relative z-10 text-center max-w-xl mx-auto" data-reveal>
      <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] text-3xl mb-4">Welche Leistung passt zu Ihnen?</h2>
      <p class="text-[#62626E] mb-8">Im kostenlosen Erstgespräch finden wir gemeinsam die optimale Lösung.</p>
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]">
        Kostenloses Beratungsgespräch
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { serviceSchema, faqPageSchema } from '@/lib/schema';
import { projekte } from '@/data/projekte';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { iso, processIcons } from '@/data/visuals';

const pageUrl = `${SITE.url}/leistungen/wordpress-astro-migration`;

const caseTeasers = [...projekte]
  .filter(p => p.techStack.some(t => t.includes('Astro')))
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);

const wordpressSetups = [
  'WordPress Classic', 'Elementor', 'Divi', 'Gutenberg', 'WooCommerce (Content)', 'Multisite',
];

const headlessCms = [
  { name: 'Sanity', desc: 'Flexibles Studio, ideal für Marketing-Teams' },
  { name: 'Strapi', desc: 'Open Source, Self-hosted oder Cloud' },
  { name: 'Contentful', desc: 'Enterprise-ready, skalierbar' },
  { name: 'Decap CMS', desc: 'Git-basiert, schlank & wartungsarm' },
  { name: 'WordPress (Headless)', desc: 'Schrittweise Entkopplung möglich' },
];

const migratedData = [
  'Seiten & Beiträge', 'Medien & Bilder', 'SEO-Titel & Meta', 'URL-Struktur & Redirects',
  'Kategorien & Tags', 'Formulare & CTAs', 'Navigation & Footer', 'Structured Data',
  'Mehrsprachigkeit', 'Autoren & Redaktions-Workflow', 'Blog-Archive', 'Analytics & Tracking',
];

const steps = [
  { n: '01', title: 'Audit & Migrationsplan', desc: 'WordPress-Setup, Plugins, Themes, SEO-Situation und Content-Struktur — wir definieren Zielarchitektur und Headless CMS.' },
  { n: '02', title: 'Astro-Frontend & Design', desc: 'Neues Frontend in Astro.js: schnell, barrierefrei, komponentenbasiert — passend zu Ihrer Marke.' },
  { n: '03', title: 'Headless CMS Setup', desc: 'Content-Modelle, Redaktions-Oberfläche und Workflows — damit Ihr Team ohne Entwickler pflegen kann.' },
  { n: '04', title: 'Content-Migration', desc: 'Automatisierte und manuelle Übernahme von Inhalten, Medien und Metadaten — inklusive Qualitätscheck.' },
  { n: '05', title: 'SEO & Redirects', desc: '301-Weiterleitungen, Sitemap, Schema.org und Core Web Vitals — Rankings bleiben stabil.' },
  { n: '06', title: 'Go-Live & Übergabe', desc: 'Kontrollierter Launch, DNS-Umstellung, Schulung und optionaler Wartungs-Retainer.' },
];

const benefits = [
  { icon: iso.launch, title: 'Deutlich schneller', desc: 'Static/SSR mit Astro — Ladezeiten oft 3–5× besser als klassisches WordPress.' },
  { icon: iso.shield, title: 'Weniger Wartungsaufwand', desc: 'Kein Plugin-Chaos, weniger Sicherheitsupdates — stabiler Betrieb.' },
  { icon: iso.plan, title: 'Redaktion bleibt einfach', desc: 'Headless CMS mit klarer Oberfläche — Content-Team arbeitet weiter produktiv.' },
  { icon: iso.chart, title: 'SEO & Performance', desc: 'Saubere URLs, schnelle Core Web Vitals und technisches SEO out of the box.' },
];

const faqs = [
  {
    q: 'Verliere ich meine Google-Rankings bei WordPress zu Astro?',
    a: 'Nein — wir migrieren URLs sauber, richten 301-Redirects ein und prüfen Sitemap sowie Structured Data. Rankings bleiben in der Regel stabil.',
  },
  {
    q: 'Kann mein Team Inhalte weiterhin selbst pflegen?',
    a: 'Ja. Mit Headless CMS (z. B. Sanity oder Strapi) pflegt Ihr Redaktionsteam Texte und Medien — ohne WordPress-Backend.',
  },
  {
    q: 'Wie lange dauert die WordPress-zu-Astro-Migration?',
    a: 'Je nach Umfang typischerweise 3–10 Wochen. Nach der kostenlosen Analyse aus Hamburg oder remote erhalten Sie einen festen Zeitplan.',
  },
  {
    q: 'Was passiert mit WooCommerce?',
    a: 'WooCommerce-Shops migrieren wir separat zu Shopify. WordPress-Inhalte (Blog, Seiten) übernehmen wir in Astro + Headless CMS — auch als kombiniertes Projekt.',
  },
];

const schemas = [
  serviceSchema({
    name: 'WordPress zu Astro Migration',
    description:
      'WordPress zu Astro.js migrieren — Headless CMS, Content-Übernahme, SEO-Redirects und Core Web Vitals. Aus Hamburg, bundesweit remote.',
    serviceType: 'Website Migration',
    url: pageUrl,
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="WordPress zu Astro Migration Hamburg – Headless CMS"
  description="WordPress zu Astro.js aus Hamburg: schneller, SEO-sichere Redirects, Headless CMS. Web Agentur für HH & remote. Kostenlose Migrations-Analyse anfragen."
  schema={schemas}
  darkHero={false}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/leistungen' },
    { name: 'WordPress zu Astro', url: '/leistungen/wordpress-astro-migration' },
  ]}
>

  <DarkHero
    title="Weg von WordPress."
    accent="Hin zu Astro."
    image="/images/heroes/hero-wp.png"
    imageWidth={854}
    imageHeight={611}
    seo="WordPress zu Astro Migration in Hamburg — "
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen', href: '/leistungen' }, { label: 'WordPress zu Astro' }]}
  >
    <p>Wir migrieren Ihre WordPress-Website zu einem schnellen Astro-Frontend mit Headless CMS — inklusive Content, Redirects und Redaktion.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Kostenlose Migrations-Analyse</a>
      <a href="#prozess" class="btn btn-ghost py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Prozess ansehen</a>
    </div>
  </DarkHero>

  <!-- GEO -->
  <section class="py-12 lg:py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container max-w-3xl">
      <p class="text-[#62626E] text-base lg:text-lg leading-relaxed" data-reveal>
        <strong class="text-[#0C0C0F] font-semibold">Web Agentur in Hamburg, bundesweit remote:</strong> Wir migrieren WordPress-Websites zu Astro.js mit Headless CMS — inklusive Content-Übernahme, 301-Redirects und Redaktions-Workflow für Teams in HH und deutschlandweit.
      </p>
    </div>
  </section>

  <!-- WORDPRESS SETUPS -->
  <section class="py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container">
      <div class="flex justify-center mb-6">
        <SectionLabel tone="emerald">Typische WordPress-Ausgangssysteme</SectionLabel>
      </div>
      <ul class="chip-grid">
        {wordpressSetups.map(s => (
          <li class="chip">{s}</li>
        ))}
        <li class="chip">+ individuelle Setups</li>
      </ul>
    </div>
  </section>

  <!-- HEADLESS CMS -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Headless CMS</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-3" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Content pflegen — ohne WordPress-Backend
        </h2>
        <p class="text-[#62626E] text-sm lg:text-[15px] max-w-2xl leading-relaxed">
          Wir empfehlen das CMS passend zu Team, Budget und Workflow. Astro bleibt das schnelle Frontend — Inhalte kommen per API oder Git.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {headlessCms.map((cms, i) => (
          <div class="bg-white border border-[#EBEBEF] rounded-2xl p-6 hover:border-[#D4D4D9] transition-colors" data-reveal data-delay={String((i % 3) + 1)}>
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-2">{cms.name}</h3>
            <p class="text-[#88888F] text-sm leading-relaxed">{cms.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Warum migrieren?</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Mehr Performance, weniger technischer Ballast
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {benefits.map((b, i) => (
          <div class="p-6 bg-[#FAFAF8] rounded-2xl border border-[#EBEBEF]" data-reveal data-delay={String(i + 1)}>
            <div class="mb-4"><IsoIcon src={b.icon} /></div>
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-2">{b.title}</h3>
            <p class="text-[#88888F] text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT GETS MIGRATED -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="amber" class="mb-3">Was wir übernehmen</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Inhalte & SEO — nichts geht verloren
        </h2>
      </div>
      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-3">
        {migratedData.map((item, i) => (
          <div class="flex items-center gap-3 bg-white border border-[#EBEBEF] rounded-xl px-4 py-3.5" data-reveal data-delay={String((i % 4) + 1)}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="text-emerald-500 shrink-0">
              <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-medium text-[#44444F]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-24 bg-white" id="prozess">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">In 6 Schritten</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Ihr Weg zu Astro
          </h2>
          <p class="text-[#88888F] text-sm leading-relaxed">
            Strukturiert, SEO-sicher und mit klarem Redaktions-Setup — so sieht eine professionelle WordPress-Migration aus.
          </p>
        </div>
        <div class="space-y-0 border-t border-[#EBEBEF]">
          {steps.map((step, i) => (
            <div class="flex gap-4 sm:gap-6 py-6 border-b border-[#EBEBEF]" data-reveal data-delay={String((i % 3) + 1)}>
              <IsoIcon src={processIcons[i]} size="sm" />
              <span class="text-xs font-bold text-accent-500 tabular-nums shrink-0 mt-0.5 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1.5">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  {caseTeasers.length > 0 && (
    <section class="py-20 lg:py-24 bg-[#F4F5F7]">
      <div class="container">
        <div class="mb-10 lg:mb-12" data-reveal>
          <SectionLabel tone="emerald" class="mb-3">Referenzen</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Astro-Performance nach der Migration
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
          {caseTeasers.map((p, i) => (
            <a
              href={`/referenzen/${p.slug}`}
              class="group flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-[#F4F5F7] hover:border-[#00F573]/50 transition-all min-h-[220px]"
              data-reveal
              data-delay={String(i + 1)}
            >
              <div class="flex-1 p-6 lg:p-7 flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#00C45C] mb-3">
                  {p.service} · {p.jahr}
                </p>
                <h3 class="font-bold text-[#0A0A0C] text-xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                  {p.client}
                </h3>
                <p class="text-[#62626E] text-[14px] leading-snug max-w-sm mb-auto line-clamp-2">
                  {p.tagline}
                </p>
              </div>
              <div class="flex items-center justify-between px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D]">
                <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-20 bg-[#FAFAF8]">
    <div class="container max-w-2xl">
      <h2 class="font-bold text-[#0C0C0F] text-2xl tracking-[-0.02em] mb-8" data-reveal>Häufige Fragen</h2>
      <div class="space-y-2">
        {faqs.map(item => (
          <details class="group bg-white rounded-xl border border-[#EBEBEF] hover:border-[#D4D4D9] transition-colors" data-reveal>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-[#0C0C0F] text-[14.5px] cursor-pointer">
              {item.q}
              <span class="w-5 h-5 rounded-full border border-[#EBEBEF] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 transition-transform">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[#62626E] text-sm leading-relaxed border-t border-[#EBEBEF] pt-3.5">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 border-t border-[#E4E6EB]">
    <div class="container relative z-10 text-center max-w-xl mx-auto">
      <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] text-3xl lg:text-4xl mb-4" data-reveal>Bereit für Astro statt WordPress?</h2>
      <p class="text-[#62626E] mb-8" data-reveal data-delay="1">
        Wir analysieren Ihre Website kostenlos — und zeigen den sinnvollsten Weg inkl. Headless CMS.
      </p>
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]" data-reveal data-delay="2">
        Kostenlose Migrations-Analyse
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <style>
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  </style>
</BaseLayout>

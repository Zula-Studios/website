---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { serviceSchema, faqPageSchema } from '@/lib/schema';
import { projekte } from '@/data/projekte';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { processIcons } from '@/data/visuals';

const pageUrl = `${SITE.url}/leistungen/shopify-migration`;

const caseTeasers = [...projekte]
  .filter(p => p.techStack.some(t => t.includes('Shopify')))
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);

const migrationSystems = [
  'WooCommerce', 'Magento 1 & 2', 'OXID eSales', 'Shopware', 'PrestaShop', 'Wix / Jimdo',
];

const steps = [
  { n: '01', title: 'Analyse & Audit', desc: 'Systemarchitektur, Datenstruktur, SEO-Situation — wir erstellen einen detaillierten Migrationsplan.' },
  { n: '02', title: 'Shopify-Aufbau', desc: 'Parallel richten wir den neuen Shop ein: Theme, Apps, Einstellungen — alles vorbereitet.' },
  { n: '03', title: 'Datenmigration', desc: 'Produkte, Kunden, Bestellungen, Kategorien — automatisiert und manuell geprüft.' },
  { n: '04', title: 'SEO & Redirects', desc: 'Vollständige URL-Map, 301-Weiterleitungen, Sitemap — Ihre Rankings bleiben erhalten.' },
  { n: '05', title: 'QA & Testing', desc: 'Checkout, Zahlungen, E-Mails, Mobile — intensives Testing vor dem Launch.' },
  { n: '06', title: 'Go-Live & Support', desc: 'Kontrollierter Switchover, minimale Downtime. 60 Tage Post-Launch-Support inklusive.' },
];

const migratedData = [
  'Produkte & Varianten', 'Kundendaten', 'Bestellhistorie', 'Kategorien', 'Produktbewertungen',
  'Blogbeiträge', 'SEO-URLs & Redirects', 'Produktbilder', 'Zahlungsanbieter', 'Versandoptionen',
  'Gutscheincodes', 'Analytics-Setup',
];

const faqs = [
  { q: 'Verliere ich meine SEO-Rankings bei der Shopify Migration?', a: 'Nein — wir erstellen eine vollständige URL-Map, richten 301-Weiterleitungen ein und prüfen Sitemap sowie Structured Data. Rankings bleiben in der Regel stabil.' },
  { q: 'Wie lange dauert eine Migration zu Shopify?', a: 'Typischerweise 2–8 Wochen — abhängig von Produkten, Bestellhistorie und Integrationen. Nach der kostenlosen Analyse (Hamburg oder remote) erhalten Sie einen festen Plan.' },
  { q: 'Gibt es Downtime während der Migration?', a: 'Wir bauen den Shopify-Shop parallel auf. Beim finalen Switchover planen wir meist unter 30 Minuten Unterbrechung — oft außerhalb der Peak-Zeiten.' },
  { q: 'Von welchen Systemen migriert ihr zu Shopify?', a: 'WooCommerce, Magento, OXID, Shopware, PrestaShop und weitere — inklusive Datenmapping, Theme, Redirects und QA vor dem Go-Live.' },
];

const schemas = [
  serviceSchema({
    name: 'Shopify Migration',
    description:
      'Migration zu Shopify von WooCommerce, Magento, OXID und Shopware — datensicher, SEO-neutral, aus Hamburg bundesweit.',
    serviceType: 'E-Commerce Migration',
    url: pageUrl,
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="Shopify Migration Hamburg – SEO-sicher wechseln"
  description="Shopify Migration aus Hamburg: WooCommerce, Magento, OXID & Shopware — datensicher, SEO-neutral, minimal Downtime. Kostenlose Analyse jetzt anfragen."
  schema={schemas}
  darkHero={false}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/leistungen' },
    { name: 'Shopify Migration', url: '/leistungen/shopify-migration' },
  ]}
>

  <DarkHero
    title="Zu Shopify —"
    accent="ohne Verluste."
    image="/images/heroes/hero-migration.png"
    imageWidth={794}
    imageHeight={648}
    seo="Shopify Migration in Hamburg — "
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen', href: '/leistungen' }, { label: 'Shopify Migration' }]}
  >
    <p>Wir migrieren Ihren bestehenden Shop zu Shopify — vollständig, SEO-neutral und mit minimaler Unterbrechung.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Kostenlose Migrations-Analyse</a>
      <a href="#prozess" class="btn btn-ghost py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Prozess ansehen</a>
    </div>
  </DarkHero>

  <!-- GEO -->
  <section class="py-12 lg:py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container max-w-3xl">
      <p class="text-[#62626E] text-base lg:text-lg leading-relaxed" data-reveal>
        <strong class="text-[#0C0C0F] font-semibold">Shopify Agentur in Hamburg, bundesweit remote:</strong> Wir migrieren Shops aus der Hansestadt und begleiten E-Commerce-Teams in ganz Deutschland — mit Staged Migration, SEO-sicheren Redirects und klarem QA vor dem Go-Live.
      </p>
    </div>
  </section>

  <!-- SYSTEMS -->
  <section class="py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container">
      <div class="flex justify-center mb-6">
        <SectionLabel tone="emerald">Wir migrieren von</SectionLabel>
      </div>
      <ul class="chip-grid">
        {migrationSystems.map(s => (
          <li class="chip">{s}</li>
        ))}
        <li class="chip chip--accent">+ weitere Systeme</li>
      </ul>
    </div>
  </section>

  <!-- WHAT GETS MIGRATED -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Vollständige Datenmigration</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Kein Datenpunkt bleibt zurück
        </h2>
      </div>
      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-3">
        {migratedData.map((item, i) => (
          <div class="flex items-center gap-3 bg-white border border-[#EBEBEF] rounded-xl px-4 py-3.5" data-reveal data-delay={String((i % 4) + 1)}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="text-emerald-500 shrink-0">
              <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-medium text-[#44444F]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-24 bg-white" id="prozess">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">In 6 Schritten</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Ihr Weg zu Shopify
          </h2>
          <p class="text-[#88888F] text-sm leading-relaxed">Strukturiert, transparent und sicher — so sieht eine professionelle Migration aus.</p>
        </div>
        <div class="space-y-0 border-t border-[#EBEBEF]">
          {steps.map((step, i) => (
            <div class="flex gap-4 sm:gap-6 py-6 border-b border-[#EBEBEF]" data-reveal data-delay={String((i % 3) + 1)}>
              <IsoIcon src={processIcons[i]} size="sm" />
              <span class="text-xs font-bold text-[#00F573] tabular-nums shrink-0 mt-0.5 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1.5">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  {caseTeasers.length > 0 && (
    <section class="py-20 lg:py-24 bg-[#F4F5F7]">
      <div class="container">
        <div class="mb-10 lg:mb-12" data-reveal>
          <SectionLabel tone="emerald" class="mb-3">Referenzen</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Shopify-Erfahrung aus echten Projekten
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
          {caseTeasers.map((p, i) => (
            <a
              href={`/referenzen/${p.slug}`}
              class="group flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-[#F4F5F7] hover:border-[#00F573]/50 transition-all min-h-[220px]"
              data-reveal
              data-delay={String(i + 1)}
            >
              <div class="flex-1 p-6 lg:p-7 flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#00C45C] mb-3">
                  {p.service} · {p.jahr}
                </p>
                <h3 class="font-bold text-[#0A0A0C] text-xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                  {p.client}
                </h3>
                <p class="text-[#62626E] text-[14px] leading-snug max-w-sm mb-auto line-clamp-2">
                  {p.tagline}
                </p>
              </div>
              <div class="flex items-center justify-between px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D]">
                <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-20 bg-[#FAFAF8]">
    <div class="container max-w-2xl">
      <h2 class="font-bold text-[#0C0C0F] text-2xl tracking-[-0.02em] mb-8" data-reveal>Häufige Fragen</h2>
      <div class="space-y-2">
        {faqs.map(item => (
          <details class="group bg-white rounded-xl border border-[#EBEBEF] hover:border-[#D4D4D9] transition-colors" data-reveal>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-[#0C0C0F] text-[14.5px] cursor-pointer">
              {item.q}
              <span class="w-5 h-5 rounded-full border border-[#EBEBEF] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 transition-transform">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[#62626E] text-sm leading-relaxed border-t border-[#EBEBEF] pt-3.5">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 border-t border-[#E4E6EB]">
    <div class="container relative z-10 text-center max-w-xl mx-auto">
      <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] text-3xl lg:text-4xl mb-4" data-reveal>Bereit für den Wechsel zu Shopify?</h2>
      <p class="text-[#62626E] mb-8" data-reveal data-delay="1">Lassen Sie uns Ihren Shop analysieren — kostenlos, unverbindlich, innerhalb von 48 Stunden.</p>
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]" data-reveal data-delay="2">
        Kostenlose Migrations-Analyse
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <style>
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  </style>
</BaseLayout>

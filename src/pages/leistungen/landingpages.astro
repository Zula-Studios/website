---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import SectionLabel from '@/components/SectionLabel.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Landingpages mit Astro',
  description:
    'Conversion-starke Landingpages mit Astro.js — schnell, mobil optimiert und perfekt für Ads, Launches und Lead-Kampagnen.',
  provider: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  serviceType: 'Web Design & Development',
  areaServed: { '@type': 'Country', name: 'Germany' },
};

const useCases = [
  'Produkt-Launches', 'Google & Meta Ads', 'Lead-Generierung', 'Event-Anmeldungen',
  'Waitlist & Pre-Launch', 'Kampagnen & Aktionen', 'B2B-Anfragen', 'App-Downloads',
];

const included = [
  'Conversion-orientiertes Design', 'Mobile-first & barrierefrei', 'Hero, Benefits & Social Proof',
  'FAQ & klarer CTA', 'Kontakt- oder Lead-Formular', 'GA4 & Meta Pixel', 'Core Web Vitals optimiert',
  'SEO-Basis (Meta, Schema)', 'DSGVO-konformes Tracking-Setup', '1 Revision-Runde', 'Launch & DNS-Setup',
];

const steps = [
  { n: '01', title: 'Briefing & Ziel', desc: 'Zielgruppe, Conversion-Ziel und Kampagnen-Kontext — wir definieren Struktur und Message.' },
  { n: '02', title: 'Wireframe & Copy', desc: 'Klare Seitenstruktur und überzeugende Texte — bevor Design und Code starten.' },
  { n: '03', title: 'Design & Astro-Build', desc: 'Markenkonformes Design, umgesetzt als schnelle Astro-Landingpage mit wiederverwendbaren Komponenten.' },
  { n: '04', title: 'Tracking & Formulare', desc: 'Analytics, Conversion-Events, Formular-Anbindung (E-Mail, CRM oder Webhook).' },
  { n: '05', title: 'QA & Performance', desc: 'Cross-Browser-Tests, Lighthouse-Check und Feinschliff für Ads-Quality-Score.' },
  { n: '06', title: 'Go-Live', desc: 'Deployment, Domain, SSL — Ihre Kampagne kann starten. Optional: Varianten für A/B-Tests.' },
];

const benefits = [
  { title: 'Blitzschnell', desc: 'Astro liefert statische Seiten mit Top-Ladezeiten — besser für Ads und Conversion.', chip: 'icon-chip--blue' },
  { title: 'Conversion-fokussiert', desc: 'Klare Struktur, starke CTAs und Social Proof — keine Ablenkung.', chip: 'icon-chip--coral' },
  { title: 'Kampagnen-ready', desc: 'Tracking, UTM-fähig und optimiert für Google Ads & Meta.', chip: 'icon-chip--violet' },
  { title: 'Wiederverwendbar', desc: 'Komponenten-Bibliothek für künftige Kampagnen und Varianten.', chip: 'icon-chip--emerald' },
];
---

<BaseLayout
  title="Landingpages mit Astro – Schnell, conversion-stark & ads-ready"
  description="Professionelle Landingpages mit Astro.js: schnell, mobil optimiert, tracking-fertig. Ideal für Ads, Produkt-Launches und Lead-Kampagnen. Jetzt anfragen."
  schema={serviceSchema}
  darkHero={true}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/leistungen' },
    { name: 'Landingpages', url: '/leistungen/landingpages' },
  ]}
>

  <!-- HERO -->
  <section class="bg-[#0C0C0F] pb-20 pt-16 lg:pb-28 lg:pt-20 relative overflow-hidden hero-glow">
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="container relative z-10">
      <nav class="flex items-center gap-2 text-xs text-[#9898A0] mb-10 flex-wrap">
        <a href="/" class="hover:text-white transition-colors">Startseite</a><span>/</span>
        <a href="/leistungen" class="hover:text-white transition-colors">Leistungen</a><span>/</span>
        <span class="text-[#AEAEB5]">Landingpages</span>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 border border-[#1C1C25] rounded-full px-4 py-1.5 text-[11.5px] text-[#9898A0] font-medium mb-8">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
          Astro Landingpages
        </div>
        <h1
          class="font-bold text-white tracking-[-0.04em] leading-[0.93] mb-6"
          style="font-size: clamp(2.75rem, 7vw, 6rem); animation: fadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.1s both"
        >
          Landingpages,<br/>
          <span class="font-light italic text-white/55">die in Sekunden</span><br/>
          überzeugen.
        </h1>
        <p class="text-[#AEAEB5] text-base lg:text-lg max-w-xl leading-relaxed mb-10" style="animation: fadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.2s both">
          Wir bauen conversion-starke Landingpages mit Astro.js — schnell, mobil optimiert und perfekt für Ads, Launches und Lead-Kampagnen.
        </p>
        <div class="flex flex-wrap gap-3" style="animation: fadeUp 0.7s cubic-bezier(0.22,1,0.36,1) 0.3s both">
          <a href="/projekt-starten" class="btn bg-white text-[#0C0C0F] hover:bg-[#F5F5F8] py-3.5 px-7 text-[15px] rounded-xl font-semibold">
            Landingpage anfragen
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#prozess" class="btn btn-ghost py-3.5 px-7 text-[15px]">Prozess ansehen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container">
      <div class="flex justify-center mb-6">
        <SectionLabel tone="coral">Ideal für</SectionLabel>
      </div>
      <div class="flex flex-wrap gap-2.5 justify-center">
        {useCases.map(s => (
          <div class="flex items-center gap-2 bg-[#FAFAF8] border border-[#EBEBEF] rounded-xl px-4 py-2.5 text-sm font-medium text-[#44444F]">
            {s}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="blue" class="mb-3">Warum Astro?</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Schnell laden, schnell konvertieren
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {benefits.map((b, i) => (
          <div class="p-6 bg-white rounded-2xl border border-[#EBEBEF]" data-reveal data-delay={String(i + 1)}>
            <div class={`icon-chip ${b.chip} mb-4`}>
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 10l4 4 8-8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-2">{b.title}</h3>
            <p class="text-[#88888F] text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INCLUDED -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="violet" class="mb-3">Im Paket enthalten</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Alles für einen erfolgreichen Launch
        </h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {included.map((item, i) => (
          <div class="flex items-center gap-3 bg-[#FAFAF8] border border-[#EBEBEF] rounded-xl px-4 py-3.5" data-reveal data-delay={String((i % 4) + 1)}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="text-emerald-500 shrink-0">
              <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-medium text-[#44444F]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]" id="prozess">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">In 6 Schritten</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Von der Idee zur live Kampagne
          </h2>
          <p class="text-[#88888F] text-sm leading-relaxed">
            Kompakter Prozess, klare Meilensteine — typischerweise live in 2–3 Wochen.
          </p>
        </div>
        <div class="space-y-0 border-t border-[#EBEBEF] bg-white rounded-2xl px-6 lg:px-8">
          {steps.map((step, i) => (
            <div class="flex gap-7 py-6 border-b border-[#EBEBEF] last:border-0" data-reveal data-delay={String((i % 3) + 1)}>
              <span class="text-xs font-bold text-accent-500 tabular-nums shrink-0 mt-0.5 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1.5">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="container max-w-2xl">
      <h2 class="font-bold text-[#0C0C0F] text-2xl tracking-[-0.02em] mb-8" data-reveal>Häufige Fragen</h2>
      <div class="space-y-2">
        {[
          {
            q: 'Wie schnell ist eine Landingpage live?',
            a: 'Typischerweise in 2–3 Wochen — ab Briefing bis Go-Live. Express-Sprints sind nach Absprache möglich.',
          },
          {
            q: 'Kann ich mehrere Varianten für A/B-Tests bekommen?',
            a: 'Ja. Wir bauen Varianten als Astro-Komponenten — z. B. unterschiedliche Headlines oder CTAs — und unterstützen beim Tracking.',
          },
          {
            q: 'Wird Tracking für Google Ads und Meta eingerichtet?',
            a: 'Ja — GA4, Meta Pixel und Conversion-Events gehören zum Standard. CRM-Anbindung (HubSpot, Pipedrive etc.) ist optional.',
          },
          {
            q: 'Brauche ich WordPress oder ein CMS?',
            a: 'Für reine Kampagnen-Landingpages meist nicht. Inhalte pflegen wir gemeinsam im Projekt — oder wir binden ein schlankes Headless CMS an, wenn Sie häufiger ändern möchten.',
          },
        ].map(item => (
          <details class="group bg-[#FAFAF8] rounded-xl border border-[#EBEBEF] hover:border-[#D4D4D9] transition-colors" data-reveal>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-[#0C0C0F] text-[14.5px] cursor-pointer">
              {item.q}
              <span class="w-5 h-5 rounded-full border border-[#EBEBEF] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 transition-transform">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[#62626E] text-sm leading-relaxed border-t border-[#EBEBEF] pt-3.5">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0C0C0F] py-20 relative overflow-hidden cta-glow">
    <div class="container relative z-10 text-center max-w-xl mx-auto">
      <h2 class="font-bold text-white tracking-[-0.03em] text-3xl lg:text-4xl mb-4" data-reveal>Kampagne geplant?</h2>
      <p class="text-[#9898A0] mb-8" data-reveal data-delay="1">
        Erzählen Sie uns von Ihrem Projekt — wir melden uns mit einem konkreten Vorschlag.
      </p>
      <a href="/projekt-starten" class="btn btn-accent py-3.5 px-8 text-[15px] rounded-xl font-semibold" data-reveal data-delay="2">
        Landingpage anfragen
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <style>
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  </style>
</BaseLayout>

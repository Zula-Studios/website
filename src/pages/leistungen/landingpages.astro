---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { serviceSchema, faqPageSchema } from '@/lib/schema';
import { projekte } from '@/data/projekte';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { iso, processIcons } from '@/data/visuals';

const pageUrl = `${SITE.url}/leistungen/landingpages`;

const caseTeasers = [...projekte]
  .filter(p => p.techStack.some(t => t.includes('Astro')) && (p.tags.includes('Leadgenerierung') || p.tags.includes('Conversion')))
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);

const useCases = [
  'Produkt-Launches', 'Google & Meta Ads', 'Lead-Generierung', 'Event-Anmeldungen',
  'Waitlist & Pre-Launch', 'Kampagnen & Aktionen', 'B2B-Anfragen', 'App-Downloads',
];

const included = [
  'Conversion-orientiertes Design', 'Mobile-first & barrierefrei', 'Hero, Benefits & Social Proof',
  'FAQ & klarer CTA', 'Kontakt- oder Lead-Formular', 'GA4 & Meta Pixel', 'Core Web Vitals optimiert',
  'SEO-Basis (Meta, Schema)', 'DSGVO-konformes Tracking-Setup', '1 Revision-Runde', 'Launch & DNS-Setup',
];

const steps = [
  { n: '01', title: 'Briefing & Ziel', desc: 'Zielgruppe, Conversion-Ziel und Kampagnen-Kontext — wir definieren Struktur und Message.' },
  { n: '02', title: 'Wireframe & Copy', desc: 'Klare Seitenstruktur und überzeugende Texte — bevor Design und Code starten.' },
  { n: '03', title: 'Design & Astro-Build', desc: 'Markenkonformes Design, umgesetzt als schnelle Astro-Landingpage mit wiederverwendbaren Komponenten.' },
  { n: '04', title: 'Tracking & Formulare', desc: 'Analytics, Conversion-Events, Formular-Anbindung (E-Mail, CRM oder Webhook).' },
  { n: '05', title: 'QA & Performance', desc: 'Cross-Browser-Tests, Lighthouse-Check und Feinschliff für Ads-Quality-Score.' },
  { n: '06', title: 'Go-Live', desc: 'Deployment, Domain, SSL — Ihre Kampagne kann starten. Optional: Varianten für A/B-Tests.' },
];

const benefits = [
  { icon: iso.launch, title: 'Blitzschnell', desc: 'Astro liefert statische Seiten mit Top-Ladezeiten — besser für Ads und Conversion.' },
  { icon: iso.target, title: 'Conversion-fokussiert', desc: 'Klare Struktur, starke CTAs und Social Proof — keine Ablenkung.' },
  { icon: iso.chart, title: 'Kampagnen-ready', desc: 'Tracking, UTM-fähig und optimiert für Google Ads & Meta.' },
  { icon: iso.style, title: 'Wiederverwendbar', desc: 'Komponenten-Bibliothek für künftige Kampagnen und Varianten.' },
];

const faqs = [
  {
    q: 'Wie schnell ist eine Landingpage live?',
    a: 'Typischerweise in 2–3 Wochen — ab Briefing bis Go-Live. Express-Sprints sind nach Absprache möglich.',
  },
  {
    q: 'Kann ich mehrere Varianten für A/B-Tests bekommen?',
    a: 'Ja. Wir bauen Varianten als Astro-Komponenten — z. B. unterschiedliche Headlines oder CTAs — und unterstützen beim Tracking.',
  },
  {
    q: 'Wird Tracking für Google Ads und Meta eingerichtet?',
    a: 'Ja — GA4, Meta Pixel und Conversion-Events gehören zum Standard. CRM-Anbindung (HubSpot, Pipedrive etc.) ist optional.',
  },
  {
    q: 'Brauche ich WordPress oder ein CMS?',
    a: 'Für reine Kampagnen-Landingpages meist nicht. Inhalte pflegen wir gemeinsam im Projekt — oder wir binden ein schlankes Headless CMS an, wenn Sie häufiger ändern möchten.',
  },
];

const schemas = [
  serviceSchema({
    name: 'Landingpages mit Astro',
    description:
      'Conversion-starke Astro-Landingpages aus Hamburg — schnell, ads-ready, mit Tracking und Formularen. Bundesweit remote.',
    serviceType: 'Landing Page Development',
    url: pageUrl,
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="Landingpages Hamburg – Astro, schnell & conversion-stark"
  description="Landingpages aus Hamburg mit Astro.js: schnell, ads-ready, GA4 & Meta Pixel inklusive. Web Agentur für HH & remote. Jetzt Landingpage anfragen."
  schema={schemas}
  darkHero={false}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/leistungen' },
    { name: 'Landingpages', url: '/leistungen/landingpages' },
  ]}
>

  <DarkHero
    title="Landingpages,"
    accent="die konvertieren."
    image="/images/heroes/hero-landing.png"
    imageWidth={638}
    imageHeight={766}
    seo="Landingpages erstellen in Hamburg — "
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen', href: '/leistungen' }, { label: 'Landingpages' }]}
  >
    <p>Wir bauen conversion-starke Landingpages mit Astro.js — schnell, mobil optimiert und passend für Ads, Launches und Lead-Kampagnen.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Landingpage anfragen</a>
      <a href="#prozess" class="btn btn-ghost py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Prozess ansehen</a>
    </div>
  </DarkHero>

  <!-- GEO -->
  <section class="py-12 lg:py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container max-w-3xl">
      <p class="text-[#62626E] text-base lg:text-lg leading-relaxed" data-reveal>
        <strong class="text-[#0C0C0F] font-semibold">Web Agentur in Hamburg, bundesweit remote:</strong> Wir bauen Astro-Landingpages für Kampagnen in der Metropolregion und für Teams in ganz Deutschland — mit Top Core Web Vitals, sauberem Tracking und klaren Conversion-Zielen.
      </p>
    </div>
  </section>

  <!-- USE CASES -->
  <section class="py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container">
      <div class="flex justify-center mb-6">
        <SectionLabel tone="coral">Ideal für</SectionLabel>
      </div>
      <ul class="chip-grid">
        {useCases.map(s => (
          <li class="chip">{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Warum Astro?</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Schnell laden, schnell konvertieren
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {benefits.map((b, i) => (
          <div class="p-6 bg-white rounded-2xl border border-[#EBEBEF]" data-reveal data-delay={String(i + 1)}>
            <div class="mb-4"><IsoIcon src={b.icon} /></div>
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-2">{b.title}</h3>
            <p class="text-[#88888F] text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INCLUDED -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Im Paket enthalten</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Alles für einen erfolgreichen Launch
        </h2>
      </div>
      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-4 gap-3">
        {included.map((item, i) => (
          <div class="flex items-center gap-3 bg-[#FAFAF8] border border-[#EBEBEF] rounded-xl px-4 py-3.5" data-reveal data-delay={String((i % 4) + 1)}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="text-emerald-500 shrink-0">
              <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-medium text-[#44444F]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]" id="prozess">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">In 6 Schritten</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Von der Idee zur live Kampagne
          </h2>
          <p class="text-[#88888F] text-sm leading-relaxed">
            Kompakter Prozess, klare Meilensteine — typischerweise live in 2–3 Wochen.
          </p>
        </div>
        <div class="space-y-0 border-t border-[#EBEBEF] bg-white rounded-2xl px-6 lg:px-8">
          {steps.map((step, i) => (
            <div class="flex gap-4 sm:gap-6 py-6 border-b border-[#EBEBEF] last:border-0" data-reveal data-delay={String((i % 3) + 1)}>
              <IsoIcon src={processIcons[i]} size="sm" />
              <span class="text-xs font-bold text-accent-500 tabular-nums shrink-0 mt-0.5 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1.5">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  {caseTeasers.length > 0 && (
    <section class="py-20 lg:py-24 bg-[#F4F5F7]">
      <div class="container">
        <div class="mb-10 lg:mb-12" data-reveal>
          <SectionLabel tone="emerald" class="mb-3">Referenzen</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Landingpages & Lead-Funnels in Aktion
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
          {caseTeasers.map((p, i) => (
            <a
              href={`/referenzen/${p.slug}`}
              class="group flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-[#F4F5F7] hover:border-[#00F573]/50 transition-all min-h-[220px]"
              data-reveal
              data-delay={String(i + 1)}
            >
              <div class="flex-1 p-6 lg:p-7 flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#00C45C] mb-3">
                  {p.service} · {p.jahr}
                </p>
                <h3 class="font-bold text-[#0A0A0C] text-xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                  {p.client}
                </h3>
                <p class="text-[#62626E] text-[14px] leading-snug max-w-sm mb-auto line-clamp-2">
                  {p.tagline}
                </p>
              </div>
              <div class="flex items-center justify-between px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D]">
                <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="container max-w-2xl">
      <h2 class="font-bold text-[#0C0C0F] text-2xl tracking-[-0.02em] mb-8" data-reveal>Häufige Fragen</h2>
      <div class="space-y-2">
        {faqs.map(item => (
          <details class="group bg-[#FAFAF8] rounded-xl border border-[#EBEBEF] hover:border-[#D4D4D9] transition-colors" data-reveal>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-[#0C0C0F] text-[14.5px] cursor-pointer">
              {item.q}
              <span class="w-5 h-5 rounded-full border border-[#EBEBEF] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 transition-transform">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[#62626E] text-sm leading-relaxed border-t border-[#EBEBEF] pt-3.5">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 border-t border-[#E4E6EB]">
    <div class="container relative z-10 text-center max-w-xl mx-auto">
      <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] text-3xl lg:text-4xl mb-4" data-reveal>Kampagne geplant?</h2>
      <p class="text-[#62626E] mb-8" data-reveal data-delay="1">
        Erzählen Sie uns von Ihrem Projekt — wir melden uns mit einem konkreten Vorschlag.
      </p>
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]" data-reveal data-delay="2">
        Landingpage anfragen
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <style>
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  </style>
</BaseLayout>

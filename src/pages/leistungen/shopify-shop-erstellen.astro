---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import { serviceSchema, faqPageSchema } from '@/lib/schema';
import { projekte } from '@/data/projekte';
import SectionLabel from '@/components/SectionLabel.astro';
import DarkHero from '@/components/DarkHero.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { iso, processIcons } from '@/data/visuals';

const pageUrl = `${SITE.url}/leistungen/shopify-shop-erstellen`;

const caseTeasers = [...projekte]
  .filter(p => p.serviceType === 'shop' || p.techStack.some(t => t.includes('Shopify')))
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 2);

const deliverables = [
  'Shopify-Konzept & UX/UI', 'Custom Theme (Liquid)', 'Produkt- & Kollektions-Setup',
  'Checkout & Zahlungsanbieter', 'Versand & Steuern (DE/EU)', 'SEO-Grundsetup & Schema',
  'GA4, GTM & Pixel', 'Schulung & Dokumentation', 'Launch & DNS', '60 Tage Post-Launch-Support',
];

const steps = [
  { n: '01', title: 'Briefing & Strategie', desc: 'Zielgruppe, Sortiment, Markenauftritt und technische Anforderungen — Grundlage für Konzept und Angebot.' },
  { n: '02', title: 'Design & UX', desc: 'Wireframes, UI-Design und mobile-first Prototypen — abgestimmt auf Conversion und Ihre Marke.' },
  { n: '03', title: 'Theme-Entwicklung', desc: 'Custom Sections, Blöcke und Templates in Liquid — performant und wartbar.' },
  { n: '04', title: 'Inhalte & Integrationen', desc: 'Produkte, Apps, ERP/PIM-Anbindungen und Zahlungs- sowie Versandsetup.' },
  { n: '05', title: 'QA & Performance', desc: 'Checkout-Tests, Core Web Vitals, SEO-Check und Tracking vor dem Go-Live.' },
  { n: '06', title: 'Launch & Betreuung', desc: 'Go-Live, Schulung Ihres Teams und Support in den ersten Wochen nach dem Start.' },
];

const faqs = [
  { q: 'Wie lange dauert die Entwicklung eines Shopify Shops?', a: 'Einfache Shops: 2–4 Wochen. Individuelle Custom-Shops: 2–4 Monate. Nach dem Briefing in Hamburg oder per Video erhalten Sie einen festen Zeitplan.' },
  { q: 'Welchen Shopify-Plan brauche ich?', a: 'Das hängt von Umsatz, B2B-Anforderungen und Apps ab. Wir beraten Sie neutral — ohne Vendor-Lock-in über unnötige Add-ons.' },
  { q: 'Kümmert ihr euch auch um Produkte und Texte?', a: 'Ja — auf Wunsch übernehmen wir Content und Bilder. Alternativ schulen wir Ihr Team für die Pflege im Shopify Admin.' },
  { q: 'Arbeitet ihr nur in Hamburg?', a: 'Unser Studio sitzt in Hamburg — Projekte betreuen wir deutschlandweit remote mit festen Ansprechpartnern und wöchentlichen Updates.' },
];

const schemas = [
  serviceSchema({
    name: 'Shopify Shop erstellen',
    description:
      'Shopify Shop Entwicklung in Hamburg: Custom Theme, SEO, Performance und Launch — für Unternehmen in HH und bundesweit remote.',
    serviceType: 'Shopify Development',
    url: pageUrl,
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="Shopify Shop erstellen Hamburg – Custom Theme"
  description="Shopify Shop in Hamburg erstellen lassen: Custom Theme, SEO & Performance. Shopify Agentur für HH & bundesweit remote. Jetzt kostenloses Angebot anfragen."
  schema={schemas}
  darkHero={false}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Leistungen', url: '/leistungen' },
    { name: 'Shopify Shop erstellen', url: '/leistungen/shopify-shop-erstellen' },
  ]}
>

  <DarkHero
    title="Shopify Shops,"
    accent="die verkaufen."
    image="/images/heroes/hero-shopify.png"
    imageWidth={684}
    imageHeight={744}
    seo="Shopify Shop erstellen in Hamburg — "
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Leistungen', href: '/leistungen' }, { label: 'Shopify Shop erstellen' }]}
  >
    <p>Wir entwickeln performante, conversion-optimierte Shopify-Shops — vom ersten Gespräch bis zum erfolgreichen Launch.</p>
    <div class="hero-actions">
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Kostenloses Angebot</a>
      <a href="/referenzen" class="btn btn-ghost py-3.5 px-7 text-[14px] uppercase tracking-[0.06em]">Referenzen ansehen</a>
    </div>
  </DarkHero>

  <!-- GEO -->
  <section class="py-12 lg:py-16 bg-white border-b border-[#EBEBEF]">
    <div class="container max-w-3xl">
      <p class="text-[#62626E] text-base lg:text-lg leading-relaxed" data-reveal>
        <strong class="text-[#0C0C0F] font-semibold">Shopify Agentur in Hamburg, bundesweit remote:</strong> Wir planen, designen und entwickeln Shopify-Shops für Marken in der Metropolregion — und begleiten E-Commerce-Teams in ganz Deutschland per Video, Slack und festen Meilensteinen.
      </p>
    </div>
  </section>

  <!-- WHY SHOPIFY — horizontal scroll features -->
  <section class="py-20 lg:py-24 bg-white">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Warum Shopify</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">Die führende E-Commerce Plattform</h2>
      </div>
      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { icon: iso.launch, title: 'Schnell & skalierbar', desc: 'Globales CDN inklusive — von 0 auf Millionen Bestellungen.' },
          { icon: iso.shield, title: 'Sicher & verlässlich', desc: '99,99% Uptime, PCI-DSS, kostenloses SSL, kein Hosting-Stress.' },
          { icon: iso.mobile, title: 'Mobile-first', desc: 'Alle Themes vollständig mobiloptimiert. Core Web Vitals included.' },
          { icon: iso.pin, title: 'International', desc: 'Multi-Sprache, Multi-Währung und lokale Zahlungsanbieter out of the box.' },
          { icon: iso.code, title: '8.000+ Apps', desc: 'Der größte App Store im E-Commerce. Jede Integration verfügbar.' },
          { icon: iso.chart, title: 'Analytics', desc: 'GA4, GTM, Shopify Audiences — datengetriebenes Wachstum.' },
        ].map((item, i) => (
          <div class="p-6 bg-[#FAFAF8] rounded-2xl border border-[#EBEBEF] hover:bg-white hover:border-[#D4D4D9] transition-all" data-reveal data-delay={String((i % 3) + 1)}>
            <div class="mb-4">
              <IsoIcon src={item.icon} />
            </div>
            <h3 class="font-semibold text-[#0C0C0F] text-[14.5px] mb-1.5">{item.title}</h3>
            <p class="text-[#88888F] text-xs leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DELIVERABLES -->
  <section class="py-20 lg:py-24 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Leistungsumfang</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Was beim Shopify Shop dabei ist
        </h2>
      </div>
      <div class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-5 gap-3">
        {deliverables.map((item, i) => (
          <div class="flex items-center gap-3 bg-white border border-[#EBEBEF] rounded-xl px-4 py-3.5" data-reveal data-delay={String((i % 5) + 1)}>
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="text-accent-500 shrink-0">
              <path d="M2 7l4 4 6-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="text-sm font-medium text-[#44444F]">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="py-20 lg:py-24 bg-white" id="prozess">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-16 lg:gap-24">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">In 6 Schritten</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-4" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Von der Idee zum live Shop
          </h2>
          <p class="text-[#88888F] text-sm leading-relaxed">Transparent, iterativ und launch-sicher — so entstehen Shopify-Shops, die verkaufen.</p>
        </div>
        <div class="space-y-0 border-t border-[#EBEBEF]">
          {steps.map((step, i) => (
            <div class="flex gap-4 sm:gap-6 py-6 border-b border-[#EBEBEF]" data-reveal data-delay={String((i % 3) + 1)}>
              <IsoIcon src={processIcons[i]} size="sm" />
              <span class="text-xs font-bold text-[#00F573] tabular-nums shrink-0 mt-0.5 w-6">{step.n}</span>
              <div>
                <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1.5">{step.title}</h3>
                <p class="text-[#88888F] text-sm leading-relaxed">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CASES -->
  {caseTeasers.length > 0 && (
    <section class="py-20 lg:py-24 bg-[#F4F5F7]">
      <div class="container">
        <div class="mb-10 lg:mb-12" data-reveal>
          <SectionLabel tone="emerald" class="mb-3">Referenzen</SectionLabel>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
            Shopify-Projekte aus der Praxis
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-5">
          {caseTeasers.map((p, i) => (
            <a
              href={`/referenzen/${p.slug}`}
              class="group flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-[#F4F5F7] hover:border-[#00F573]/50 transition-all min-h-[220px]"
              data-reveal
              data-delay={String(i + 1)}
            >
              <div class="flex-1 p-6 lg:p-7 flex flex-col">
                <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#00C45C] mb-3">
                  {p.service} · {p.jahr}
                </p>
                <h3 class="font-bold text-[#0A0A0C] text-xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                  {p.client}
                </h3>
                <p class="text-[#62626E] text-[14px] leading-snug max-w-sm mb-auto line-clamp-2">
                  {p.tagline}
                </p>
              </div>
              <div class="flex items-center justify-between px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D]">
                <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="py-20 bg-white">
    <div class="container max-w-2xl">
      <h2 class="font-bold text-[#0C0C0F] tracking-[-0.02em] text-2xl mb-8" data-reveal>Häufige Fragen</h2>
      <div class="space-y-2">
        {faqs.map(item => (
          <details class="group bg-[#FAFAF8] rounded-xl border border-[#EBEBEF] hover:border-[#D4D4D9] transition-colors" data-reveal>
            <summary class="flex items-center justify-between gap-4 px-5 py-4 font-semibold text-[#0C0C0F] text-[14.5px] cursor-pointer">
              {item.q}
              <span class="w-5 h-5 rounded-full border border-[#EBEBEF] flex items-center justify-center shrink-0 text-[#AEAEB5] group-open:rotate-45 transition-transform">
                <svg width="9" height="9" viewBox="0 0 10 10" fill="none"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </span>
            </summary>
            <div class="px-5 pb-4 text-[#62626E] text-sm leading-relaxed border-t border-[#EBEBEF] pt-3.5">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 border-t border-[#E4E6EB]">
    <div class="container relative z-10 text-center max-w-xl mx-auto">
      <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em] text-3xl lg:text-4xl mb-4" data-reveal>Bereit für Ihren neuen Shopify Shop?</h2>
      <p class="text-[#62626E] mb-8" data-reveal data-delay="1">Kostenloses Erstgespräch — kein Risiko, kein Verkaufsdruck.</p>
      <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[14px] uppercase tracking-[0.06em]" data-reveal data-delay="2">
        Jetzt kostenlos anfragen
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>

  <style>
    @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
  </style>
</BaseLayout>

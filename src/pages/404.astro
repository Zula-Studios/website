---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DarkHero from '@/components/DarkHero.astro';
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die gesuchte Seite wurde nicht gefunden."
  noindex={true}
>
  <DarkHero title="404" accent="nicht gefunden." image="/images/heroes/hero-home.png" imageWidth={733} imageHeight={724}>
    <p>Die gesuchte Seite existiert leider nicht mehr. Diese Links helfen weiter.</p>
    <div class="hero-actions">
      <a href="/" class="btn btn-primary text-[13px] uppercase tracking-[0.04em]">Startseite</a>
      <a href="/leistungen" class="btn btn-ghost text-[13px] uppercase tracking-[0.04em]">Leistungen</a>
      <a href="/kontakt" class="btn btn-ghost text-[13px] uppercase tracking-[0.04em]">Kontakt</a>
    </div>
  </DarkHero>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import Icon from '@/components/Icon.astro';
import SectionLabel from '@/components/SectionLabel.astro';

const team = [
  {
    name: 'Serdar Sahbazoglu',
    role: 'Gründer & Lead Developer',
    bio: 'Shopify-Experte seit 2018. Spezialisiert auf Custom Apps und komplexe Migrationen.',
    initials: 'SS',
    photo: '/images/team/serdar-sahbazoglu.png',
  },
  {
    name: 'Michael Gibert',
    role: 'Aushilfe in Social Media und E-Commerce',
    bio: 'Gerade Abi abgeschlossen und möchte sich in Social Media und Marketing beweisen. Zusätzlich wird der E-Commerce nähergebracht.',
    initials: 'MG',
    photo: '/images/team/michael-gibert.svg',
  },
];

const values = [
  { iconName: 'target', title: 'Ergebnisorientiert', desc: 'Jede Entscheidung zielt auf messbare Conversion.', chip: 'icon-chip--blue' },
  { iconName: 'eye', title: 'Transparent', desc: 'Keine versteckten Kosten. Klare Kommunikation.', chip: 'icon-chip--violet' },
  { iconName: 'layers', title: 'Technisch tief', desc: 'Shopify bis in die Tiefe — APIs, Liquid, Apps.', chip: 'icon-chip--emerald' },
  { iconName: 'users', title: 'Partnerschaftlich', desc: 'Wir denken mit und empfehlen ehrlich.', chip: 'icon-chip--coral' },
];

const stats = [
  { value: '10+', label: 'Abgeschlossene Projekte', valueClass: 'text-accent-600', accent: 'blue' },
  { value: '10+', label: 'Jahre Erfahrung', valueClass: 'text-violet-600', accent: 'violet' },
  { value: '20+', label: 'Zufriedene Kunden', valueClass: 'text-emerald-600', accent: 'emerald' },
  { value: '98%', label: 'Kundenzufriedenheit', valueClass: 'text-amber-600', accent: 'amber' },
];
---

<BaseLayout
  title="Über uns – Shopify-Experten aus Hamburg"
  description="Das Team hinter Zula Studios — Shopify-Experten mit über 10 Jahren Erfahrung und 10+ erfolgreich abgeschlossenen E-Commerce-Projekten."
  darkHero={true}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Über uns', url: '/ueber-uns' }]}
>
  <!-- Hero -->
  <section class="bg-[#0C0C0F] py-20 lg:py-28 relative overflow-hidden hero-glow">
    <div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="container relative z-10">
      <nav class="flex items-center gap-2 text-xs text-[#9898A0] mb-10">
        <a href="/" class="hover:text-white transition-colors">Startseite</a><span>/</span>
        <span class="text-white">Über uns</span>
      </nav>
      <SectionLabel tone="blue" class="mb-4 text-accent-400">Über Zula Studios</SectionLabel>
      <h1 class="font-bold text-white tracking-[-0.04em] max-w-2xl" style="font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 0.93;">
        Shopify-Experten<br/>
        <span class="font-light italic text-white/55">aus <span class="text-accent-300/90">Hamburg.</span></span>
      </h1>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-28 items-start">
        <div data-reveal>
          <SectionLabel tone="emerald" class="mb-4">Unsere Geschichte</SectionLabel>
          <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em] mb-6" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
            Warum wir {SITE.name} gegründet haben
          </h2>
          <div class="space-y-4 text-[#62626E] leading-relaxed text-sm lg:text-[15px]">
            <p>Zu viele gute Produkte scheitern an schlechten Online-Shops. Händler kämpften mit langsamen WooCommerce-Installationen, unintuitivem Design und Dienstleistern, die mehr versprachen als sie lieferten.</p>
            <p>Wir gründeten Zula Studios mit einem klaren Versprechen: Transparente Entwicklung, messbare Ergebnisse und ein Partner, der unternehmerisch mitdenkt.</p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3" data-reveal data-delay="2">
          {stats.map(stat => (
            <div class={`relative overflow-hidden p-6 bg-[#FAFAF8] rounded-2xl border border-[#EBEBEF] stat-accent stat-accent--${stat.accent}`}>
              <div class={`font-bold text-3xl tracking-[-0.04em] mb-1 ${stat.valueClass}`}>{stat.value}</div>
              <div class="text-[#88888F] text-xs">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="py-20 bg-[#FAFAF8]">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="violet" class="mb-3">Team</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">Menschen hinter dem Code</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl">
        {team.map((m, i) => (
          <div class="relative overflow-hidden bg-white rounded-2xl p-7 border border-[#EBEBEF] hover:border-accent-200 transition-colors" data-reveal data-delay={String(i + 1)}>
            <div class={`absolute top-0 left-0 right-0 h-0.5 opacity-60 ${i === 0 ? 'bg-accent-500' : 'bg-emerald-500'}`}></div>
            {m.photo ? (
              <img
                src={m.photo}
                alt={m.name}
                width={128}
                height={128}
                loading="lazy"
                class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-contain mb-6"
              />
            ) : (
              <div class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl bg-[#0C0C0F] text-white font-bold text-lg flex items-center justify-center mb-6 tracking-wide">
                {m.initials}
              </div>
            )}
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-0.5">{m.name}</h3>
            <p class="text-accent-600 text-xs font-medium mb-3">{m.role}</p>
            <p class="text-[#88888F] text-sm leading-relaxed">{m.bio}</p>
          </div>
        ))}
      </div>

      {SITE.githubRepo && (
        <a
          href={SITE.githubRepo}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 flex items-center gap-5 max-w-4xl p-6 bg-white rounded-2xl border border-[#EBEBEF] hover:border-accent-200 transition-colors group"
          data-reveal
          data-delay="3"
        >
          <div class="w-14 h-14 rounded-xl bg-accent-600 text-white flex items-center justify-center shrink-0 group-hover:bg-accent-700 transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="label mb-1">Open Source</p>
            <h3 class="font-semibold text-[#0C0C0F] text-[15px] mb-1 group-hover:text-accent-600 transition-colors">
              Zula Studios auf GitHub
            </h3>
            <p class="text-[#88888F] text-sm leading-relaxed">
              Quellcode dieser Website und weitere Projekte — transparent und einsehbar.
            </p>
          </div>
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="shrink-0 text-[#AEAEB5] group-hover:text-accent-600 group-hover:translate-x-0.5 transition-all" aria-hidden="true">
            <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      )}
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 bg-white">
    <div class="container">
      <div class="mb-12" data-reveal>
        <SectionLabel tone="emerald" class="mb-3">Unsere Werte</SectionLabel>
        <h2 class="font-bold text-[#0C0C0F] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">Wofür wir stehen</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {values.map((v, i) => (
          <div class="p-6 bg-[#FAFAF8] rounded-2xl border border-[#EBEBEF] hover:bg-white hover:border-[#D4D4D9] transition-all" data-reveal data-delay={String(i + 1)}>
            <div class={`icon-chip ${v.chip} mb-4`}>
              <Icon name={v.iconName} size={20} strokeWidth={1.5} />
            </div>
            <h3 class="font-semibold text-[#0C0C0F] text-[14.5px] mb-2">{v.title}</h3>
            <p class="text-[#88888F] text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[#0C0C0F] py-20 relative overflow-hidden cta-glow">
    <div class="container relative z-10 text-center max-w-lg mx-auto" data-reveal>
      <h2 class="font-bold text-white tracking-[-0.03em] text-3xl mb-4">Lassen Sie uns zusammenarbeiten.</h2>
      <p class="text-[#9898A0] mb-8">Wir freuen uns auf Ihr Projekt.</p>
      <a href="/kontakt" class="btn btn-accent py-3.5 px-8 rounded-xl font-semibold text-[15px]">
        Kontakt aufnehmen
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>

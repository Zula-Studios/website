---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const hasBooking = Boolean(SITE.calcom);
---

<BaseLayout
  title="Vielen Dank für Ihre Anfrage"
  description="Wir haben Ihre Anfrage erhalten und melden uns innerhalb von 24 Stunden."
  noindex={true}
>
  <section class:list={['flex items-center justify-center py-20', hasBooking ? 'pb-10' : 'min-h-[60vh]']}>
    <div class="max-w-lg mx-auto px-4 text-center">
      <div class="w-20 h-20 rounded-full bg-accent-500/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-10 h-10 text-accent-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-display font-extrabold text-3xl lg:text-4xl text-gray-900 mb-4">
        Vielen Dank!
      </h1>
      <p class="text-gray-500 text-lg leading-relaxed">
        Wir haben Ihre Anfrage erhalten und melden uns innerhalb von <strong class="text-gray-900">24 Stunden</strong> bei Ihnen.
      </p>
      {!hasBooking && (
        <a href="/" class="mt-8 inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-xl transition-all">
          Zurück zur Startseite
        </a>
      )}
    </div>
  </section>

  {hasBooking && (
    <section class="pb-20">
      <div class="container max-w-3xl">
        <div class="rounded-2xl border border-[#EBEBEF] bg-[#FAFAF8] p-6 sm:p-8">
          <div class="text-center mb-6">
            <p class="text-[11px] font-semibold tracking-[0.18em] uppercase text-accent-600 mb-2">Noch schneller</p>
            <h2 class="font-bold text-[#0C0C0F] text-xl lg:text-2xl tracking-[-0.02em] mb-1.5">
              Direkt Termin sichern
            </h2>
            <p class="text-[#88888F] text-sm">
              Buchen Sie jetzt Ihr kostenloses Kennenlerngespräch (30 Min) – ohne E-Mail-Pingpong.
            </p>
          </div>
          <div id="cal-inline" class="min-h-[520px]"></div>
          <p class="text-center mt-4 text-xs text-[#AEAEB5]">
            Kalender lädt nicht?
            <a href={`${SITE.calcomOrigin}/${SITE.calcom}`} target="_blank" rel="noopener noreferrer" class="text-accent-600 hover:underline">Hier direkt buchen</a>
          </p>
        </div>
        <p class="text-center mt-6">
          <a href="/" class="text-sm text-[#88888F] hover:text-[#0C0C0F] transition-colors">Zurück zur Startseite</a>
        </p>
      </div>
    </section>
  )}
</BaseLayout>

{hasBooking && (
  <script define:vars={{ calLink: SITE.calcom, calOrigin: SITE.calcomOrigin }}>
    // Cal-Inline-Embed (cal.eu) mit Name/E-Mail-Prefill aus den Formular-Query-Parametern.
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal; let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {}; cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); }
          else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, calOrigin + '/embed/embed.js', 'init');

    const params = new URLSearchParams(window.location.search);
    const prefill = {};
    if (params.get('name')) prefill.name = params.get('name');
    if (params.get('email')) prefill.email = params.get('email');

    Cal('init', 'erstgespraech', { origin: calOrigin });
    Cal.ns['erstgespraech']('inline', {
      elementOrSelector: '#cal-inline',
      config: { layout: 'month_view', ...prefill },
      calLink: calLink,
    });
    Cal.ns['erstgespraech']('ui', {
      hideEventTypeDetails: false,
      layout: 'month_view',
    });
  </script>
)}

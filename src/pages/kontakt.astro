---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import Icon from '@/components/Icon.astro';
import SectionLabel from '@/components/SectionLabel.astro';
import { localBusinessSchema } from '@/lib/schema';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Kontakt – Zula Studios Hamburg',
  description:
    'Kontakt zur Shopify Agentur Zula Studios in Hamburg: Telefon, E-Mail und Formular.',
  url: `${SITE.url}/kontakt`,
  mainEntity: { '@id': `${SITE.url}/#localservice` },
};

const schema = [contactPageSchema, localBusinessSchema()];
---

<BaseLayout
  title="Kontakt Shopify Agentur Hamburg"
  description="Shopify Agentur Hamburg: hello@zulastudios.com, +49 176 34 44 74 85. Formular und Antwort in 24 Std."
  schema={schema}
  darkHero={false}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Kontakt', url: '/kontakt' }]}
>

  <!-- HERO -->
  <section class="bg-[#0A0A0C] pt-24 lg:pt-28 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-end">
      <div class="relative z-10 px-5 sm:px-8 lg:pl-[max(2.5rem,calc((100vw-1240px)/2+2.5rem))] lg:pr-8 pt-8 pb-12 lg:pb-16">
        <nav class="flex items-center gap-2 text-xs text-white/45 mb-8">
          <a href="/" class="hover:text-white transition-colors">Startseite</a>
          <span>/</span>
          <span class="text-white/80 font-medium">Kontakt</span>
        </nav>
        <h1
          class="font-extrabold italic uppercase text-white tracking-[-0.035em]"
          style="font-size: clamp(2.6rem, 5.6vw, 4.75rem); line-height: 0.92;"
        >
          Lass uns<br />
          <span class="text-[#00F573]">reden.</span>
        </h1>

        <div class="mt-8 max-w-md rounded-2xl bg-[#F3F4F6] px-5 py-4 sm:px-6 sm:py-5">
          <h2 class="font-bold text-[#0A0A0C] text-base tracking-[-0.02em] mb-3">Kontakt</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <a href={`mailto:${SITE.email}`} class="group min-w-0">
              <span class="flex items-center gap-2 text-[13px] font-semibold text-[#0A0A0C] mb-1">
                <svg width="15" height="15" viewBox="0 0 20 20" fill="none" class="text-[#0A0A0C]" aria-hidden="true">
                  <path d="M3 6.5h14v9H3v-9z" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 7l7 5 7-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                E-Mail
              </span>
              <span class="block text-[14px] text-[#0A0A0C] underline underline-offset-2 decoration-[#0A0A0C]/40 group-hover:decoration-[#00C45C] truncate">{SITE.email}</span>
            </a>
            <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="group min-w-0">
              <span class="flex items-center gap-2 text-[13px] font-semibold text-[#0A0A0C] mb-1">
                <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="text-[#0A0A0C]" aria-hidden="true">
                  <path d="M3 5a2 2 0 012-2h2.2a1 1 0 01.95.68l1.1 3.3a1 1 0 01-.5 1.18l-1.5.75a8.5 8.5 0 004.84 4.84l.75-1.5a1 1 0 011.18-.5l3.3 1.1a1 1 0 01.68.95V15a2 2 0 01-2 2h-1C7.8 17 3 12.2 3 6V5z"/>
                </svg>
                Telefon
              </span>
              <span class="block text-[14px] text-[#0A0A0C] underline underline-offset-2 decoration-[#0A0A0C]/40 group-hover:decoration-[#00C45C]">{SITE.phone}</span>
            </a>
          </div>
        </div>
      </div>

      <div class="relative flex items-end justify-center lg:justify-end min-h-[220px] sm:min-h-[280px] lg:min-h-[420px] pointer-events-none">
        <img
          src="/images/contact-hero.png"
          alt=""
          width="935"
          height="972"
          class="w-full max-w-[420px] h-auto object-contain object-bottom"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- MAIN -->
  <section class="bg-white py-16 lg:py-24">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[360px_1fr] gap-12 lg:gap-20 items-start">

        <!-- Left: contact info -->
        <aside class="lg:sticky lg:top-28 space-y-8" data-reveal>

          <div>
            <SectionLabel tone="emerald" class="mb-5">Direkter Kontakt</SectionLabel>
            <div class="space-y-4">

              <a href={`mailto:${SITE.email}`} class="flex items-center gap-4 group p-4 rounded-2xl border border-[#EBEBEF] hover:border-[#D4D4D9] hover:bg-[#FAFAF8] transition-all">
                <div class="w-11 h-11 rounded-xl bg-[#F5F5F8] group-hover:bg-accent-50 flex items-center justify-center transition-colors shrink-0">
                  <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[#88888F] group-hover:text-accent-600 transition-colors">
                    <path d="M3 7l7 5 7-5M3 6h14a1 1 0 011 1v8a1 1 0 01-1 1H3a1 1 0 01-1-1V7a1 1 0 011-1z" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
                <div>
                  <div class="text-[10px] label mb-0.5">E-Mail</div>
                  <div class="text-sm font-semibold text-[#0C0C0F] group-hover:text-accent-600 transition-colors">{SITE.email}</div>
                </div>
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="ml-auto text-[#AEAEB5] group-hover:text-accent-600 group-hover:translate-x-0.5 transition-all">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              <a href={`tel:${SITE.phone.replace(/\s/g, '')}`} class="flex items-center gap-4 group p-4 rounded-2xl border border-[#EBEBEF] hover:border-[#D4D4D9] hover:bg-[#FAFAF8] transition-all">
                <div class="w-11 h-11 rounded-xl bg-[#F5F5F8] group-hover:bg-accent-50 flex items-center justify-center transition-colors shrink-0">
                  <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="text-[#88888F] group-hover:text-accent-600 transition-colors">
                    <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V17a2 2 0 01-2 2h-1C9.716 19 3 12.284 3 4V3z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-[10px] label mb-0.5">Telefon</div>
                  <div class="text-sm font-semibold text-[#0C0C0F] group-hover:text-accent-600 transition-colors">{SITE.phone}</div>
                </div>
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="ml-auto text-[#AEAEB5] group-hover:text-accent-600 group-hover:translate-x-0.5 transition-all">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

              {SITE.githubRepo && (
                <a href={SITE.githubRepo} target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 group p-4 rounded-2xl border border-[#EBEBEF] hover:border-[#D4D4D9] hover:bg-[#FAFAF8] transition-all">
                  <div class="w-11 h-11 rounded-xl bg-[#F5F5F8] group-hover:bg-accent-50 flex items-center justify-center transition-colors shrink-0">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[#88888F] group-hover:text-accent-600 transition-colors">
                      <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="text-[10px] label mb-0.5">GitHub</div>
                    <div class="text-sm font-semibold text-[#0C0C0F] group-hover:text-accent-600 transition-colors">Zula-Studios</div>
                  </div>
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="ml-auto text-[#AEAEB5] group-hover:text-accent-600 group-hover:translate-x-0.5 transition-all">
                    <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              )}

            </div>
          </div>

          <!-- CTA to project wizard -->
          <div class="rounded-2xl bg-[#F4F5F7] border border-[#E4E6EB] p-5">
            <p class="text-[#0A0A0C] font-semibold text-[15px] mb-1.5 tracking-[-0.01em]">Haben Sie ein konkretes Projekt?</p>
            <p class="text-[#62626E] text-sm leading-relaxed mb-4">Nutzen Sie unseren geführten Projektassistenten für eine schnellere Antwort.</p>
            <a href="/projekt-starten" class="inline-flex items-center gap-2 btn btn-primary text-[13px] font-semibold px-4 py-2.5 rounded-xl hover:bg-[#F5F5F8] transition-colors">
              Projekt starten
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div></aside>

        <!-- Right: simple form -->
        <div data-reveal data-delay="2">

          <div class="mb-8">
            <h2 class="font-bold text-[#0C0C0F] text-2xl lg:text-3xl tracking-[-0.03em] mb-2">Nachricht schicken</h2>
            <p class="text-[#88888F] text-sm">Allgemeine Anfragen, Feedback oder einfach ein kurzes Hallo – wir lesen alles.</p>
          </div>

          <form id="contact-form" novalidate class="space-y-4">

            <!-- Name + Email -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="float-group">
                <input type="text" id="name" name="name" required placeholder=" " class="float-input" autocomplete="name" />
                <label for="name" class="float-label">Name *</label>
              </div>
              <div class="float-group">
                <input type="email" id="email" name="email" required placeholder=" " class="float-input" autocomplete="email" />
                <label for="email" class="float-label">E-Mail *</label>
              </div>
            </div>

            <!-- Phone (optional) -->
            <div class="float-group">
              <input type="tel" id="telefon" name="telefon" placeholder=" " class="float-input" autocomplete="tel" />
              <label for="telefon" class="float-label">Telefon (optional)</label>
            </div>

            <!-- Message -->
            <div class="float-group float-group--textarea">
              <textarea id="nachricht" name="nachricht" required placeholder=" " rows="6" maxlength="1000" class="float-input float-textarea"></textarea>
              <label for="nachricht" class="float-label float-label--textarea">Ihre Nachricht *</label>
              <div id="char-counter" class="absolute bottom-3 right-3.5 text-[10.5px] text-[#D4D4D9] pointer-events-none tabular-nums">0 / 1000</div>
            </div>

            <!-- GDPR -->
            <div class="flex items-start gap-3 pt-1">
              <div class="custom-cb-wrapper mt-0.5 shrink-0 cursor-pointer" id="cb-wrapper">
                <input type="checkbox" id="datenschutz" name="datenschutz" required class="sr-only" />
                <div class="cb-box w-5 h-5 rounded-md border-2 border-[#D4D4D9] flex items-center justify-center transition-all duration-150">
                  <svg width="10" height="10" viewBox="0 0 12 12" fill="none" class="cb-check opacity-0 scale-75 transition-all duration-150">
                    <path d="M2 6l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>
              <label for="datenschutz" class="text-xs text-[#88888F] leading-relaxed cursor-pointer">
                Ich habe die <a href="/datenschutz" class="text-accent-600 hover:underline">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. *
              </label>
            </div>

            <!-- Submit -->
            <div class="pt-2">
              <button type="submit" class="btn btn-primary w-full justify-center py-4 text-[15px]" id="submit-btn">
                Nachricht absenden
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <p id="form-error" class="hidden mt-3 text-sm text-red-600 text-center leading-relaxed"></p>
              <p class="text-center text-xs text-[#D4D4D9] mt-3">Wir antworten innerhalb von 24 Stunden · Kein Spam</p>
            </div>

          </form>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }
  .float-group { position: relative; }
  .float-input { width: 100%; padding: 1.5rem 1rem 0.625rem; background: #FAFAF8; border: 1.5px solid #EBEBEF; border-radius: 0.875rem; font-size: 0.875rem; color: #0A0A0C; outline: none; transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease; font-family: inherit; }
  .float-input:hover { border-color: #D4D4D9; }
  .float-input:focus { border-color: #00C45C; background: white; box-shadow: 0 0 0 3px rgba(0,196,92,0.15); }
  .float-textarea    { resize: none; padding-bottom: 2rem; }
  .float-label       { position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); font-size: 0.875rem; color: #AEAEB5; pointer-events: none; transition: top 0.15s ease, font-size 0.15s ease, color 0.15s ease, transform 0.15s ease; white-space: nowrap; transform-origin: left center; }
  .float-label--textarea { top: 1rem; transform: none; }
  .float-input:focus ~ .float-label,
  .float-input:not(:placeholder-shown) ~ .float-label { top: 0.45rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.03em; color: #00C45C; transform: none; }
  .float-textarea:focus ~ .float-label--textarea,
  .float-textarea:not(:placeholder-shown) ~ .float-label--textarea { top: 0.35rem; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.03em; color: #00C45C; }
  .custom-cb-wrapper:hover .cb-box { border-color: #AEAEB5; }
  .cb-box.is-checked { background: #00C45C; border-color: #00C45C; }
  .cb-box.is-checked .cb-check { opacity: 1 !important; transform: scale(1) !important; }
  #submit-btn.loading { opacity: 0.7; pointer-events: none; }
  #submit-btn.loading::after { content: ''; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.35); border-top-color: white; border-radius: 50%; animation: spin 0.6s linear infinite; margin-left: 0.25rem; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-4px)} 40%,80%{transform:translateX(4px)} }
  .shake { animation: shake 0.4s ease; }
</style>

<script>
  // ── Checkbox ────────────────────────────────────────────────────────────────
  const cbWrapper = document.getElementById('cb-wrapper');
  const cbInput   = document.getElementById('datenschutz') as HTMLInputElement | null;
  const cbBox     = cbWrapper?.querySelector('.cb-box');
  cbWrapper?.addEventListener('click', () => {
    if (!cbInput) return;
    cbInput.checked = !cbInput.checked;
    cbBox?.classList.toggle('is-checked', cbInput.checked);
  });
  document.querySelector('label[for="datenschutz"]')?.addEventListener('click', (e) => {
    e.preventDefault();
    cbWrapper?.click();
  });

  // ── Character counter ────────────────────────────────────────────────────────
  const textarea = document.getElementById('nachricht') as HTMLTextAreaElement | null;
  const counter  = document.getElementById('char-counter');
  textarea?.addEventListener('input', () => {
    const len = textarea.value.length;
    if (counter) {
      counter.textContent = `${len} / 1000`;
      counter.style.color = len > 960 ? '#DC2626' : len > 880 ? '#00C45C' : '#D4D4D9';
    }
  });

  // ── Form submit via fetch ────────────────────────────────────────────────────
  const form      = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const fd = new FormData(form);
    const data: Record<string, string> = {};
    fd.forEach((v, k) => { data[k] = v.toString(); });
    data['datenschutz'] = (document.getElementById('datenschutz') as HTMLInputElement)?.checked ? 'true' : 'false';

    if (data['datenschutz'] !== 'true') {
      cbBox?.parentElement?.classList.add('shake');
      setTimeout(() => cbBox?.parentElement?.classList.remove('shake'), 500);
      return;
    }

    submitBtn?.classList.add('loading');

    try {
      const res  = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();

      if (res.ok && json.ok) {
        const params = new URLSearchParams({ name: data['name'] ?? '', email: data['email'] ?? '' });
        window.location.href = `/danke?${params.toString()}`;
      } else {
        throw new Error(json.error ?? 'Unbekannter Fehler');
      }
    } catch (err) {
      submitBtn?.classList.remove('loading');
      const errMsg = document.getElementById('form-error');
      if (errMsg) {
        const fallback =
          'Es ist ein Fehler aufgetreten. Bitte versuche es erneut oder schreibe uns direkt an hello@zulastudios.com.';
        errMsg.textContent = err instanceof Error && err.message ? err.message : fallback;
        errMsg.classList.remove('hidden');
      }
    }
  });
</script>

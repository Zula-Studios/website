---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DarkHero from '@/components/DarkHero.astro';
import { SITE } from '@/config/site';
import { projekte, type ServiceType } from '@/data/projekte';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Referenzen – Shopify & Webprojekte Hamburg | Zula Studios',
    description:
      'Case Studies von Zula Studios Hamburg: Shopify Shops, Astro-Websites, Migrationen und Laravel-Entwicklungen.',
    url: `${SITE.url}/referenzen`,
    about: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    provider: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      address: {
        '@type': 'PostalAddress',
        addressLocality: SITE.address.city,
        addressCountry: SITE.address.country,
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Referenzen Zula Studios',
    numberOfItems: projekte.length,
    itemListElement: projekte.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/referenzen/${p.slug}`,
      name: `${p.client} – ${p.service}`,
    })),
  },
];

const sorted = [...projekte].sort((a, b) => Number(b.featured) - Number(a.featured));

const filters: { key: ServiceType | 'all'; label: string }[] = [
  { key: 'all', label: 'Alle Leistungen' },
  { key: 'shop', label: 'Shopify' },
  { key: 'website', label: 'Websites' },
  { key: 'migration', label: 'Migration' },
  { key: 'entwicklung', label: 'Entwicklung' },
];

const techFilters = [...new Set(projekte.flatMap(p => p.techStack))].slice(0, 10);
---

<BaseLayout
  title="Referenzen Hamburg – Shopify, Astro & Laravel Cases"
  description="Echte Projekte der Shopify Agentur Zula Studios in Hamburg: Shops, Websites, Migrationen und Laravel-Systeme. Cases mit Tech-Stack und Ergebnis."
  schema={schema}
  breadcrumbs={[{ name: 'Startseite', url: '/' }, { name: 'Referenzen', url: '/referenzen' }]}
  darkHero={false}
  keywords={['Referenzen Shopify Hamburg', 'Case Studies Webagentur', 'Shopify Projekte Hamburg']}
>

  <DarkHero
    title="Referenzen"
    accent="mit Ergebnis."
    image="/images/heroes/hero-cases.png"
    imageWidth={736}
    imageHeight={776}
    crumbs={[{ label: 'Startseite', href: '/' }, { label: 'Cases' }]}
  >
    <p>Shopify, Astro und Laravel — ausgewählte Projekte mit Tech-Stack, Leistungen und Outcome.</p>
  </DarkHero>

  <section id="projekte" class="bg-white pb-20 lg:pb-28 scroll-mt-20 pt-8 lg:pt-10">
    <div class="container">
      <div class="mb-5" id="filter-tabs" role="tablist" aria-label="Leistungsfilter">
        <div class="flex flex-wrap gap-2">
          {filters.map((f, i) => (
            <button
              type="button"
              class="filter-btn px-4 py-2.5 rounded-full text-[13px] font-semibold transition-all border"
              data-filter={f.key}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {f.label}
            </button>
          ))}
        </div>
      </div>

      <div class="mb-10 lg:mb-12">
        <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#AEAEB5] mb-3">Tech-Stack</p>
        <div class="flex flex-wrap gap-2" id="tech-tabs">
          <button
            type="button"
            class="tech-btn px-3.5 py-2 rounded-full text-[12.5px] font-medium transition-all border"
            data-tech="all"
            aria-pressed="true"
          >
            Alle
          </button>
          {techFilters.map(t => (
            <button
              type="button"
              class="tech-btn px-3.5 py-2 rounded-full text-[12.5px] font-medium transition-all border"
              data-tech={t}
              aria-pressed="false"
            >
              {t}
            </button>
          ))}
        </div>
      </div>

      <ul class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-5" id="project-list">
        {sorted.map(p => (
          <li
            class="project-card"
            data-service={p.serviceType}
            data-tech={p.techStack.join('|')}
          >
            <a
              href={`/referenzen/${p.slug}`}
              class="group relative flex flex-col rounded-2xl overflow-hidden border border-[#E4E6EB] bg-white hover:border-[#00F573]/60 hover:shadow-[0_8px_28px_rgba(0,0,0,0.06)] transition-all duration-250 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#00F573] focus-visible:outline-offset-2"
            >
              <div class="relative z-10 flex-1 flex flex-col p-4 lg:p-5">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  <span class="text-[10px] font-bold uppercase tracking-[0.12em] px-2.5 py-1 rounded-full bg-[#ECFFF4] text-[#00C45C] border border-[#00F573]/35">
                    {p.service}
                  </span>
                  <span class="text-[10px] font-bold uppercase tracking-[0.12em] px-2.5 py-1 rounded-full text-[#88888F] border border-[#E4E6EB] bg-[#F4F5F7]">
                    {p.jahr}
                  </span>
                </div>

                <div class="rounded-xl border border-[#E4E6EB] bg-[#F4F5F7] overflow-hidden mb-4">
                  <div class="flex items-center gap-2 px-3 py-2 border-b border-[#E4E6EB]">
                    <span class="flex gap-1.5 shrink-0" aria-hidden="true">
                      <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
                      <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
                      <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
                    </span>
                    <span class="min-w-0 flex-1 truncate rounded-md border border-[#E4E6EB] bg-white px-2 py-0.5 text-[11px] text-[#88888F]">
                      {p.url ? new URL(p.url).hostname.replace(/^www\./, '') : 'app.unfallpaten.de'}
                    </span>
                  </div>
                  <img
                    src={`/images/cases/${p.slug}.jpg`}
                    alt=""
                    width="1280"
                    height="800"
                    class="aspect-[2/1] w-full object-cover object-top"
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <h2 class="m-0 font-bold text-[#0A0A0C] text-xl lg:text-2xl tracking-[-0.02em] mb-2 group-hover:text-[#00C45C] transition-colors">
                  {p.client}
                </h2>
                <p class="m-0 text-[#62626E] text-[14px] lg:text-[15px] leading-snug line-clamp-2 mb-4">
                  {p.tagline}
                </p>

                <div class="flex flex-wrap gap-1.5 mt-auto">
                  {p.techStack.slice(0, 5).map(t => (
                    <span class="text-[10px] font-semibold text-[#62626E] px-2 py-0.5 rounded-md border border-[#E4E6EB] bg-[#F4F5F7]">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <div class="relative z-10 flex items-center justify-between gap-3 px-6 lg:px-7 py-3.5 bg-[#00F573] text-[#1D273D] group-hover:bg-[#3FF98F] transition-colors">
                <span class="text-[12px] font-extrabold uppercase tracking-[0.14em]">Ansehen</span>
                <svg width="16" height="16" viewBox="0 0 14 14" fill="none" class="group-hover:translate-x-1 transition-transform" aria-hidden="true">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <p id="empty-state" class="hidden text-center text-[#9898A0] text-sm py-20">
        Keine Projekte in dieser Kategorie.
      </p>
    </div>
  </section>

  <section class="bg-[#F4F5F7] py-16 lg:py-20 border-t border-[#E4E6EB]">
    <div class="container max-w-2xl text-center">
      <h2 class="font-bold text-[#0A0A0C] text-xl lg:text-2xl tracking-[-0.02em] mb-2">Ähnliches Projekt geplant?</h2>
      <p class="text-[#88888F] text-[14px] mb-7">
        Kostenloses Erstgespräch — Shopify Agentur Hamburg oder remote in DE.
      </p>
      <a href="/projekt-starten" class="btn btn-primary inline-flex uppercase tracking-[0.05em] text-[13px]">
        Angebot anfordern
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const serviceTabs = document.getElementById('filter-tabs');
  const techTabs = document.getElementById('tech-tabs');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  const empty = document.getElementById('empty-state');

  let activeService = 'all';
  let activeTech = 'all';

  function styleServiceBtn(btn: HTMLElement, on: boolean) {
    if (on) {
      btn.classList.add('bg-[#0A0A0C]', 'text-white', 'border-[#0A0A0C]');
      btn.classList.remove('bg-white', 'text-[#62626E]', 'border-[#E4E6EB]');
      btn.setAttribute('aria-selected', 'true');
    } else {
      btn.classList.remove('bg-[#0A0A0C]', 'text-white', 'border-[#0A0A0C]');
      btn.classList.add('bg-white', 'text-[#62626E]', 'border-[#E4E6EB]');
      btn.setAttribute('aria-selected', 'false');
    }
  }

  function styleTechBtn(btn: HTMLElement, on: boolean) {
    if (on) {
      btn.classList.add('bg-[#ECFFF4]', 'text-[#00C45C]', 'border-[#00F573]/50');
      btn.classList.remove('bg-white', 'text-[#62626E]', 'border-[#E4E6EB]');
      btn.setAttribute('aria-pressed', 'true');
    } else {
      btn.classList.remove('bg-[#ECFFF4]', 'text-[#00C45C]', 'border-[#00F573]/50');
      btn.classList.add('bg-white', 'text-[#62626E]', 'border-[#E4E6EB]');
      btn.setAttribute('aria-pressed', 'false');
    }
  }

  function applyFilters() {
    let visible = 0;
    cards.forEach(card => {
      const serviceOk = activeService === 'all' || card.dataset.service === activeService;
      const techList = (card.dataset.tech ?? '').split('|');
      const techOk = activeTech === 'all' || techList.includes(activeTech);
      const show = serviceOk && techOk;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  }

  serviceTabs?.querySelectorAll<HTMLElement>('.filter-btn').forEach((btn, i) => {
    styleServiceBtn(btn, i === 0);
    btn.addEventListener('click', () => {
      activeService = btn.dataset.filter ?? 'all';
      serviceTabs.querySelectorAll<HTMLElement>('.filter-btn').forEach(b => styleServiceBtn(b, b === btn));
      applyFilters();
    });
  });

  techTabs?.querySelectorAll<HTMLElement>('.tech-btn').forEach(btn => {
    styleTechBtn(btn, btn.dataset.tech === 'all');
    btn.addEventListener('click', () => {
      activeTech = btn.dataset.tech ?? 'all';
      techTabs.querySelectorAll<HTMLElement>('.tech-btn').forEach(b => styleTechBtn(b, b === btn));
      applyFilters();
    });
  });
</script>

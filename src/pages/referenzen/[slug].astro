---
import BaseLayout from '@/layouts/BaseLayout.astro';
import IsoIcon from '@/components/IsoIcon.astro';
import { SITE } from '@/config/site';
import { projekte } from '@/data/projekte';
import { iso } from '@/data/visuals';

export const prerender = true;

export function getStaticPaths() {
  return projekte.map(p => ({ params: { slug: p.slug }, props: { projekt: p } }));
}

const { projekt: p } = Astro.props;

const previewHost = p.url ? new URL(p.url).hostname.replace(/^www\./, '') : 'app.unfallpaten.de';
const currentIndex = projekte.findIndex(x => x.slug === p.slug);
const prevProjekt = projekte[(currentIndex - 1 + projekte.length) % projekte.length];
const nextProjekt = projekte[(currentIndex + 1) % projekte.length];

const leadTech = p.techStack[0];
const serviceNamesTech = p.service.toLowerCase().includes(leadTech.toLowerCase().split(' ')[0]);
const pageTitle = serviceNamesTech
  ? `${p.client} – ${p.service}`
  : `${p.client} – ${leadTech}: ${p.service}`;
const pageDescription = p.seoDescription;
const pageUrl = `${SITE.url}/referenzen/${p.slug}`;
const datePublished = `${p.jahr}-06-01`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: `${p.client} – ${p.service}`,
  description: p.seoDescription,
  url: pageUrl,
  datePublished,
  dateModified: datePublished,
  inLanguage: 'de-DE',
  keywords: [...p.techStack, ...p.tags, 'Hamburg', SITE.name].join(', '),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.address.city,
      addressCountry: SITE.address.country,
    },
  },
  about: { '@type': 'Organization', name: p.client, ...(p.url ? { url: p.url } : {}) },
};

const techSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Tech-Stack für ${p.client}`,
  description: `${SITE.name} in ${SITE.address.city} hat ${p.client} mit ${p.techStack.join(', ')} umgesetzt.`,
  numberOfItems: p.techDetails.length,
  itemListElement: p.techDetails.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    description: item.text,
  })),
};

const creativeWorkSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${p.service} für ${p.client}`,
  description: p.seoDescription,
  creator: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  dateCreated: p.jahr,
  keywords: p.techStack,
  inLanguage: 'de-DE',
  locationCreated: {
    '@type': 'Place',
    name: SITE.address.city,
    address: {
      '@type': 'PostalAddress',
      addressLocality: SITE.address.city,
      addressCountry: SITE.address.country,
    },
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={[articleSchema, creativeWorkSchema, techSchema]}
  darkHero={false}
  breadcrumbs={[
    { name: 'Startseite', url: '/' },
    { name: 'Referenzen', url: '/referenzen' },
    { name: p.client, url: `/referenzen/${p.slug}` },
  ]}
  keywords={[...p.techStack, p.service, 'Hamburg', p.client]}
>

  <section class="bg-[#0A0A0C] pt-24 lg:pt-28">
    <div class="container pt-8 pb-10 lg:pt-12 lg:pb-14">
      <nav class="flex flex-wrap items-center gap-2 text-xs text-white/45 mb-8" aria-label="Brotkrumen">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span aria-hidden="true">/</span>
        <a href="/referenzen" class="hover:text-white transition-colors">Cases</a>
        <span aria-hidden="true">/</span>
        <span class="text-white/80">{p.client}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 lg:items-center">
        <div>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="text-[10px] font-bold uppercase tracking-[0.12em] px-3 py-1 rounded-full bg-[#00F573] text-[#0A0A0C]">Case · {p.jahr}</span>
            <span class="text-[10px] font-bold uppercase tracking-[0.12em] px-3 py-1 rounded-full text-white/70 border border-white/20">{p.industry}</span>
          </div>

          <h1
            class="font-extrabold italic uppercase text-white tracking-[-0.035em]"
            style="font-size: clamp(2.2rem, 4.2vw, 3.6rem); line-height: 0.92;"
          >
            {p.client}
          </h1>
          <p class="mt-3 font-extrabold italic uppercase text-[#00F573] tracking-[-0.03em]" style="font-size: clamp(1.05rem, 2vw, 1.45rem); line-height: 1.05;">
            {p.service}
          </p>
          <p class="mt-5 max-w-xl text-white/75 text-base lg:text-lg leading-relaxed">{p.tagline}</p>

          <div class="mt-7 flex flex-col sm:flex-row gap-3">
            {p.url && (
              <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary w-full sm:w-auto text-[13px] uppercase tracking-[0.04em] justify-center">Live ansehen</a>
            )}
            <a href="/projekt-starten" class="btn btn-ghost w-full sm:w-auto text-[13px] uppercase tracking-[0.04em] justify-center">Ähnliches Projekt</a>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-[#F4F5F7] overflow-hidden">
          <div class="flex items-center gap-2 px-3 py-2.5 border-b border-[#E4E6EB]">
            <span class="flex gap-1.5 shrink-0" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-[#FF5F57]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#FEBC2E]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#28C840]"></span>
            </span>
            <span class="min-w-0 flex-1 truncate rounded-md border border-[#E4E6EB] bg-white px-3 py-1 text-[12px] text-[#88888F]">
              {previewHost}
            </span>
          </div>
          <img
            src={`/images/cases/${p.slug}.jpg`}
            alt={`Startseite von ${p.client}`}
            width="1280"
            height="800"
            class="aspect-[16/10] w-full object-cover object-top"
          />
        </div>
      </div>
    </div>

    <dl class="m-0 grid grid-cols-2 lg:grid-cols-4 border-t border-white/10">
      {p.metrics.map(m => (
        <div class="px-5 sm:px-8 py-6 lg:py-8 border-b border-white/10 lg:border-b-0 lg:border-r lg:last:border-r-0 even:border-l even:border-white/10 lg:even:border-l-0">
          <dd class="m-0 font-extrabold italic text-[#00F573] tracking-[-0.03em]" style="font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: 1;">{m.value}</dd>
          <dt class="m-0 mt-2 text-[12px] text-white/55 leading-snug">{m.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-white py-14 lg:py-20">
    <div class="container max-w-3xl">
      <p class="m-0 text-[17px] lg:text-xl text-[#0A0A0C] leading-relaxed">{p.description}</p>
    </div>
  </section>

  <section class="bg-[#F4F5F7] py-14 lg:py-20 border-y border-[#E4E6EB]">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {[
          { icon: iso.target, kicker: '01', title: 'Herausforderung', text: p.challenge },
          { icon: iso.code, kicker: '02', title: 'Lösung', text: p.solution },
          { icon: iso.launch, kicker: '03', title: 'Ergebnis', text: p.resultText },
        ].map(block => (
          <article class="flex flex-col rounded-2xl border border-[#E4E6EB] bg-white p-6 lg:p-7">
            <IsoIcon src={block.icon} />
            <p class="mt-5 mb-2 text-[11px] font-bold tracking-[0.14em] uppercase text-[#00C45C]">{block.kicker}</p>
            <h2 class="m-0 font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em] text-xl">{block.title}</h2>
            <p class="mt-3 mb-0 text-[14.5px] text-[#44444F] leading-relaxed">{block.text}</p>
          </article>
        ))}
      </div>
      <p class="mt-6 mb-0 text-[13px] text-[#9898A0]">
        Umgesetzt von {SITE.name} — Shopify & Web Agentur in {SITE.address.city}.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 lg:py-20">
    <div class="container">
      <h2 class="m-0 font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1;">
        Was gemacht wurde
      </h2>
      <ol class="m-0 mt-8 p-0 list-none grid grid-cols-1 sm:grid-cols-2 gap-3">
        {p.deliverables.map((item, i) => (
          <li class="flex gap-4 items-center rounded-2xl border border-[#E4E6EB] bg-[#FAFAF8] px-4 py-4">
            <span class="shrink-0 w-8 h-8 rounded-full flex items-center justify-center text-[12px] font-extrabold text-[#0A0A0C] bg-[#00F573]">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="text-[15px] text-[#0A0A0C] leading-snug">{item}</span>
          </li>
        ))}
      </ol>

      <h2 class="m-0 mt-14 font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1;">
        Tech-Stack
      </h2>
      <p class="mt-4 mb-0 max-w-3xl text-[16px] text-[#44444F] leading-relaxed">
        {SITE.name} in {SITE.address.city} hat für {p.client} ({p.industry}) diesen Stack eingesetzt: {p.techStack.join(', ')}.
        Jede Technik hat im Projekt eine konkrete Aufgabe.
      </p>
      <ul class="m-0 mt-6 p-0 list-none flex flex-wrap gap-2">
        {p.techStack.map(tech => (
          <li class="inline-flex items-center rounded-full border border-[#E4E6EB] bg-[#F4F5F7] px-4 py-2 text-[13.5px] font-semibold text-[#0A0A0C]">
            {tech}
          </li>
        ))}
      </ul>
      <dl class="m-0 mt-6 grid grid-cols-1 lg:grid-cols-2 gap-3">
        {p.techDetails.map(item => (
          <div class="rounded-2xl border border-[#E4E6EB] bg-[#FAFAF8] px-5 py-5">
            <dt class="m-0 font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.02em] text-lg">{item.name}</dt>
            <dd class="m-0 mt-2 text-[14.5px] text-[#44444F] leading-relaxed">{item.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bg-[#F4F5F7] py-14 lg:py-20 border-t border-[#E4E6EB]">
    <div class="container">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href={`/referenzen/${prevProjekt.slug}`} class="rounded-2xl border border-[#E4E6EB] bg-white p-6 hover:border-[#00F573] transition-colors">
          <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#9898A0]">Vorheriger Case</span>
          <span class="mt-2 block font-extrabold italic uppercase text-[#0A0A0C] text-xl tracking-[-0.02em]">{prevProjekt.client}</span>
          <span class="mt-1 block text-[13px] text-[#62626E]">{prevProjekt.service}</span>
        </a>
        <a href={`/referenzen/${nextProjekt.slug}`} class="rounded-2xl border border-[#E4E6EB] bg-white p-6 hover:border-[#00F573] transition-colors sm:text-right">
          <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-[#9898A0]">Nächster Case</span>
          <span class="mt-2 block font-extrabold italic uppercase text-[#0A0A0C] text-xl tracking-[-0.02em]">{nextProjekt.client}</span>
          <span class="mt-1 block text-[13px] text-[#62626E]">{nextProjekt.service}</span>
        </a>
      </div>
      <div class="mt-10 text-center">
        <a href="/referenzen" class="text-[13px] font-bold uppercase tracking-[0.08em] text-[#00C45C] hover:underline">Alle Cases</a>
        <h2 class="mt-8 font-extrabold italic uppercase text-[#0A0A0C] tracking-[-0.03em] text-2xl lg:text-3xl">Ähnliches Projekt?</h2>
        <p class="mt-3 mb-6 text-[#62626E] text-sm">Erstgespräch in Hamburg — unverbindlich.</p>
        <a href="/projekt-starten" class="btn btn-primary py-3.5 px-8 text-[13px] uppercase tracking-[0.06em]">Angebot anfordern</a>
      </div>
    </div>
  </section>

</BaseLayout>

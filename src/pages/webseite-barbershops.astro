---
import SEO from '@/components/SEO.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { SITE } from '@/config/site';
import { faqPageSchema, serviceSchema } from '@/lib/schema';

const CITY_ALIASES: Record<string, string> = {
  koeln: 'Köln',
  cologne: 'Köln',
  muenchen: 'München',
  munich: 'München',
  dueseldorf: 'Düsseldorf',
  nuernberg: 'Nürnberg',
};

function sanitizeCity(value: string | null): string {
  if (!value) return '';
  const cleaned = value
    .trim()
    .replace(/[_+]/g, ' ')
    .replace(/[^A-Za-zÄÖÜäöüß\s-]/g, '')
    .replace(/\s+/g, ' ')
    .slice(0, 32);
  if (cleaned.length < 2) return '';
  const alias = CITY_ALIASES[cleaned.toLocaleLowerCase('de-DE')];
  if (alias) return alias;
  return cleaned.replace(/\b\p{L}/gu, letter => letter.toLocaleUpperCase('de-DE'));
}

const city = sanitizeCity(Astro.url.searchParams.get('stadt') ?? Astro.url.searchParams.get('city'));
const campaign = (Astro.url.searchParams.get('utm_campaign') ?? Astro.url.searchParams.get('kampagne') ?? '').slice(0, 60);
const localLabel = city ? `in ${city}` : '';
const bookingUrl = `${SITE.calcomOrigin}/${SITE.calcom}`;
const priceParams = new URLSearchParams();
if (city) priceParams.set('stadt', city);
if (campaign) priceParams.set('utm_campaign', campaign);
const pricingHref = priceParams.toString() ? `/barbershop-webseite?${priceParams}` : '/barbershop-webseite';

const probleme = [
  { title: 'Kunden rufen an, statt zu buchen.', desc: 'Jeder Anruf unterbricht den Schnitt. Eine klare Buchung spart Zeit.' },
  { title: 'Die Seite wirkt schwächer als der Salon.', desc: 'Der erste Eindruck entsteht online – oft bevor jemand den Laden betritt.' },
  { title: 'Die Konkurrenz wird zuerst gefunden.', desc: 'Ohne lokalen Auftritt entscheidet Google für den Salon nebenan.' },
];

const vorteile = [
  { icon: '/images/body/body-booking.jpg', title: 'Termine ohne Telefonkette', desc: 'Kunden buchen direkt, auch abends und am Wochenende.' },
  { icon: '/images/body/body-style.jpg', title: 'Ihr Stil wird sichtbar', desc: 'Die Seite wirkt so gepflegt wie Ihr Handwerk.' },
  { icon: '/images/body/body-pin.jpg', title: 'Lokal besser auffindbar', desc: 'Saubere Grundlagen für Suchanfragen in Ihrer Stadt.' },
];

const ablauf = [
  { n: '01', title: '15 Minuten sprechen', desc: 'Wir schauen uns Ihren Salon und Ihre aktuelle Seite an.', icon: '/images/body/body-talk.jpg' },
  { n: '02', title: 'Klarer Vorschlag', desc: 'Sie erfahren, was sinnvoll ist – ohne Verkaufsdruck.', icon: '/images/body/body-plan.jpg' },
  { n: '03', title: 'Seite geht live', desc: 'Nach Ihrer Freigabe veröffentlichen wir den neuen Auftritt.', icon: '/images/body/body-launch.jpg' },
];

const faqs = [
  { q: 'Was kostet eine Webseite für einen Barbershop?', a: 'Es gibt monatliche Pakete ab 69 €. Preise und Leistungen sehen Sie auf der Übersichtsseite – oder wir klären sie im Gespräch.' },
  { q: 'Kann mein Buchungssystem eingebunden werden?', a: 'Ja. Gängige Terminlösungen lassen sich als direkter Buchungsweg integrieren.' },
  { q: 'Wie lange dauert die Erstellung?', a: 'Eine typische Salon-Webseite ist in wenigen Wochen fertig.' },
  { q: 'Muss ich mich sofort entscheiden?', a: 'Nein. Das Erstgespräch ist unverbindlich. Danach entscheiden Sie in Ruhe.' },
];

const serviceDescription = city
  ? `Individuelle Barbershop-Webseiten in ${city} – mobil optimiert, lokal auffindbar und auf Online-Terminbuchungen ausgerichtet.`
  : `Professionelle Webseiten für Barbershops und Friseursalons – aus ${SITE.address.city}, deutschlandweit. Mobil, buchbar, lokal sichtbar.`;

const pageSchema = [
  faqPageSchema(faqs),
  serviceSchema({
    name: city ? `Barbershop Webseite ${city}` : 'Webdesign für Barbershops & Friseure',
    description: serviceDescription,
    serviceType: 'Web design for barbershops',
    url: `${SITE.url}/webseite-barbershops`,
  }),
];

const navLinks = [
  { label: 'Vorteile', href: '#vorteile' },
  { label: 'Ablauf', href: '#ablauf' },
  { label: 'FAQ', href: '#faq' },
];

const seoTitle = city
  ? `Barbershop Webseite ${localLabel} – Termine online buchen`
  : 'Barbershop Webseite erstellen – mehr Terminbuchungen | Hamburg';
const seoDescription = city
  ? `Barbershop Webseite ${localLabel}: mobil, mit Terminbuchung und lokaler Sichtbarkeit. Zula Studios – kostenloses Erstgespräch, Pakete ab 69 €/Monat.`
  : `Webseite für Barbershops & Friseure aus Hamburg: Terminbuchung, mobiles Design, lokale SEO. Pakete ab 69 €/Monat – jetzt Erstgespräch sichern.`;
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Outfit:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700;1,800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />

    <SEO
      title={seoTitle}
      description={seoDescription}
      canonical="/webseite-barbershops"
      keywords={['Webseite für Barbershop', 'Webdesign für Friseure', 'Barbershop Webseite erstellen lassen', 'Friseur Webseite mit Terminbuchung']}
      schema={pageSchema}
    />

    <style is:global>
      :root {
        --ink: #0A0A0C;
        --muted: #62626E;
        --subtle: #9898A0;
        --border: #E4E4E9;
        --warm: #F4F5F7;
        --accent: #00C45C;
        --section: clamp(3.75rem, 7vw, 6rem);
      }
      *, *::before, *::after { box-sizing: border-box; }
      body { margin: 0; background: #fff; color: var(--ink); font-family: 'Outfit', system-ui, sans-serif; -webkit-font-smoothing: antialiased; overflow-wrap: break-word; }
      ::selection { background: #00F573; color: #1D273D; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
      .container { width: 100%; max-width: 1120px; margin-inline: auto; padding-inline: 1.125rem; }
      .section { padding-block: var(--section); }
      .section-intro { max-width: 40rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
      .section-intro h2 { margin: 0 0 1rem; font-size: clamp(1.65rem, 3.2vw, 2.4rem); line-height: 1.16; letter-spacing: -0.025em; text-wrap: balance; }
      .section-intro > p:last-child { margin: 0; max-width: 36rem; color: var(--muted); font-size: 0.9375rem; line-height: 1.65; }
      .eyebrow { margin: 0 0 0.75rem; color: var(--subtle); font-size: 0.6875rem; font-weight: 600; line-height: 1.5; letter-spacing: 0.12em; text-transform: uppercase; }
      @media (min-width: 640px) { .container { padding-inline: 2rem; } }
      @media (min-width: 1024px) { .container { padding-inline: 2.5rem; } }
    </style>
  </head>

  <body>
    <header class="sticky top-0 z-50 bg-white border-b border-[#EBEBEF]">
      <div class="container flex h-[60px] items-center justify-between">
        <a href="/" class="inline-flex items-center" aria-label={`${SITE.name} – Startseite`}>
          <img src="/images/logo.png" alt="Zula Studios" width="367" height="344" class="h-9 w-auto" style="filter:invert(1);" />
        </a>
        <nav class="hidden md:flex items-center gap-7" aria-label="Seitennavigation">
          {navLinks.map(link => <a href={link.href} class="py-2 text-[13.5px] font-medium text-[#44444F] hover:text-[#00C45C] transition-colors">{link.label}</a>)}
        </nav>
        <a href="#kontakt" class="cta header-cta">
          <span class="sm:hidden">Erstgespräch</span>
          <span class="hidden sm:inline">Kostenloses Erstgespräch</span>
        </a>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <section class="hero bg-[#0A0A0C]">
        <div class="container">
          <div class="hero-grid">
            <div class="hero-copy">
              <p class="eyebrow text-[#9898A0]">
                {city ? `Webseiten für Barbershops ${localLabel}` : 'Webseiten für Barbershops & Friseure'}
              </p>
              <h1 class="hero-title">
                {city ? (
                  <>
                    <span>Mehr Termine</span>
                    <span>für Barbershops {localLabel}.</span>
                  </>
                ) : (
                  <>
                    <span>Mehr Termine.</span>
                    <span>Weniger Anrufe.</span>
                  </>
                )}
              </h1>
              <p class="hero-description">
                {city
                  ? `Salon-Webseite ${localLabel}, die zu Ihrem Stil passt – mit klarer Terminbuchung statt Telefonkette.`
                  : `Salon-Webseite aus Hamburg: Ihr Stil online, Termine direkt buchbar – weniger Anrufe, mehr volle Stühle.`}
              </p>
              <a href="#kontakt" class="cta hero-cta">Kostenloses Erstgespräch sichern</a>
              <p class="mt-5 text-[12.5px] leading-5 text-white/50">Unverbindlich · 15 Minuten · Ohne Verkaufsdruck</p>
            </div>

            <figure class="barber-photo">
              <img
                src="/images/barbershop-hero.jpg"
                alt="Barber bei einem präzisen Haarschnitt in einem modernen Salon"
                width="1024"
                height="683"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
              <figcaption>Ihr Handwerk verdient einen Auftritt, der genauso professionell wirkt.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- Probleme -->
      <section class="section">
        <div class="container">
          <div class="section-intro">
            <p class="eyebrow">Kommt Ihnen das bekannt vor?</p>
            <h2>{city ? `Guter Salon ${localLabel} – online spürt man es nicht?` : 'Guter Salon – aber online spürt man es nicht?'}</h2>
            <p>Bevor ein neuer Kunde Ihren Stuhl erlebt, erlebt er Ihre Webseite.</p>
          </div>
          <ol class="problem-list">
            {probleme.map((problem, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{problem.title}</h3><p>{problem.desc}</p></div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- Vorteile -->
      <section id="vorteile" class="section bg-[#F4F5F7] scroll-mt-16">
        <div class="container">
          <div class="benefits-grid">
            <div class="section-intro benefits-intro">
              <p class="eyebrow">Die Lösung</p>
              <h2>Ihre Webseite macht Lust auf den ersten Termin.</h2>
              <p>Sie zeigt Ihren Stil, beantwortet wichtige Fragen und führt direkt zur Buchung.</p>
            </div>
            <div class="benefit-list">
              {vorteile.map(vorteil => (
                <div class="benefit-row">
                  <img src={vorteil.icon} alt="" width="160" height="160" loading="lazy" decoding="async" />
                  <div><h3>{vorteil.title}</h3><p>{vorteil.desc}</p></div>
                </div>
              ))}
              <a href="#kontakt" class="cta mt-7">Kostenloses Erstgespräch sichern</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Prozess -->
      <section id="ablauf" class="section bg-[#FAFAF8] border-y border-[#EBEBEF] scroll-mt-16">
        <div class="container">
          <div class="section-intro process-intro">
            <p class="eyebrow">Einfacher Ablauf</p>
            <h2>In drei Schritten zur neuen Webseite.</h2>
          </div>
          <ol class="process-list">
            {ablauf.map(schritt => (
              <li>
                <img src={schritt.icon} alt="" width="160" height="160" loading="lazy" decoding="async" />
                <span>{schritt.n}</span>
                <h3>{schritt.title}</h3>
                <p>{schritt.desc}</p>
              </li>
            ))}
          </ol>
          <p class="process-note">
            Schon Preise vergleichen?{' '}
            <a href={pricingHref} class="font-semibold text-[#00C45C] hover:underline">Pakete ansehen</a>
          </p>
        </div>
      </section>

      <!-- FAQ -->
      <section id="faq" class="section bg-[#FAFAF8] border-y border-[#EBEBEF] scroll-mt-16">
        <div class="container max-w-3xl">
          <div class="section-intro"><p class="eyebrow">Häufige Fragen</p><h2>Kurz beantwortet.</h2></div>
          <div>
            {faqs.map((faq, index) => (
              <details class="faq-item border-t border-[#D4D4D9]">
                <summary><span>{faq.q}</span><span aria-hidden="true">+</span></summary>
                {index === 0 ? (
                  <p>
                    Es gibt monatliche Pakete ab 69 €.{' '}
                    <a href={pricingHref}>Pakete und Preise ansehen</a>
                    {' '}– oder wir klären sie im Gespräch.
                  </p>
                ) : (
                  <p>{faq.a}</p>
                )}
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Kontakt -->
      <section id="kontakt" class="section bg-white border-t border-[#E4E6EB] scroll-mt-16">
        <div class="container">
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_480px] gap-12 lg:gap-16 items-center">
            <div>
              <p class="eyebrow">Jetzt starten</p>
              <h2 class="contact-title">
                {city ? `Lassen Sie uns über Ihren Salon ${localLabel} sprechen.` : 'Lassen Sie uns über Ihren Salon sprechen.'}
              </h2>
              <p class="max-w-md text-[15px] leading-[1.65] text-[#62626E]">
                Wir melden uns persönlich und besprechen unverbindlich, was für Ihren Auftritt sinnvoll ist.
              </p>
              <p class="mt-6 text-[13.5px] leading-6 text-[#62626E]">
                Lieber direkt einen Termin wählen?{' '}
                <a href={bookingUrl} class="font-semibold text-[#00C45C] hover:underline" target="_blank" rel="noopener noreferrer">
                  15 Minuten buchen
                </a>
              </p>
            </div>

            <div>
              <div class="h-1 bg-[#00F573] rounded-t-lg"></div>
              <div class="bg-white rounded-b-lg border border-[#E4E6EB] border-t-0 px-5 py-7 sm:px-8 shadow-sm">
                <h3 class="m-0 mb-1 text-[17px] leading-[1.45] font-bold">Kostenloses Erstgespräch anfragen</h3>
                <p class="m-0 mb-6 text-xs leading-[1.5] text-[#88888F]">Persönliche Antwort · Unverbindlich · Kein Spam</p>
                <form id="lead-form" novalidate class="space-y-3.5">
                  <input type="hidden" name="stadt" value={city} />
                  <input type="hidden" name="kampagne" value={campaign} />
                  <input type="hidden" name="quelle" value="webseite-barbershops" />
                  <input type="hidden" name="utm_source" value="" />
                  <input type="hidden" name="utm_medium" value="" />
                  <fieldset>
                    <legend class="sr-only">Haben Sie bereits eine Webseite?</legend>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {[
                        { value: 'hat-webseite', label: 'Habe schon eine Webseite' },
                        { value: 'braucht-webseite', label: 'Brauche eine neue Webseite' },
                      ].map((option, index) => (
                        <label class="status-option h-full cursor-pointer">
                          <input type="radio" name="status" value={option.value} class="sr-only" checked={index === 1} />
                          <span class="status-pill flex h-full min-h-[48px] items-center justify-center rounded-md border border-[#EBEBEF] px-2.5 py-2.5 text-center text-[12px] font-semibold leading-none whitespace-nowrap text-[#62626E]">{option.label}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <label class="field"><span>Name *</span><input type="text" name="name" required autocomplete="name" /></label>
                    <label class="field"><span>Salonname *</span><input type="text" name="firma" required autocomplete="organization" /></label>
                  </div>
                  <label class="field"><span>E-Mail-Adresse *</span><input type="email" name="email" required autocomplete="email" /></label>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <label class="field"><span>Telefonnummer *</span><input type="tel" name="telefon" required autocomplete="tel" inputmode="tel" /></label>
                    <label class="field"><span>Webseite (optional)</span><input type="url" name="website" inputmode="url" /></label>
                  </div>
                  <label class="field"><span>Nachricht (optional)</span><textarea name="nachricht" rows="3" maxlength="500"></textarea></label>
                  <label class="privacy">
                    <input type="checkbox" name="datenschutz" required />
                    <span>Ich habe die <a href="/datenschutz">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu. *</span>
                  </label>
                  <button id="lead-submit" type="submit" class="cta w-full">Kostenloses Erstgespräch anfragen</button>
                  <p class="m-0 text-center text-[12.5px] leading-5 text-[#88888F]">
                    <a href={pricingHref} class="font-medium text-[#00C45C] hover:underline">Pakete und Preise ansehen</a>
                  </p>
                  <p id="lead-error" class="hidden m-0 text-center text-[12.5px] leading-relaxed text-red-600" role="alert"></p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#F4F5F7] border-t border-[#E4E6EB] py-10">
      <div class="container flex flex-col sm:flex-row gap-6 items-start sm:items-center justify-between">
        <a href="/" aria-label={`${SITE.name} – Startseite`}><img src="/images/logo.png" alt="Zula Studios" width="367" height="344" class="h-8 w-auto" style="filter:invert(1);" loading="lazy" /></a>
        <div class="flex flex-wrap gap-x-6 gap-y-2 text-[13px] text-[#62626E]">
          <a href={`mailto:${SITE.email}`} class="hover:text-[#0A0A0C]">{SITE.email}</a>
          <a href="/impressum" class="hover:text-[#0A0A0C]">Impressum</a>
          <a href="/datenschutz" class="hover:text-[#0A0A0C]">Datenschutz</a>
        </div>
      </div>
    </footer>

    <div id="mobile-cta" class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-white border-t border-[#EBEBEF] p-3 translate-y-full transition-transform duration-300">
      <a href="#kontakt" class="cta w-full">Kostenloses Erstgespräch sichern</a>
    </div>
    <ConsentBanner />
  </body>
</html>

<style>
  .cta {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.5rem;
    border: 0;
    border-radius: 999px;
    background: #00F573;
    color: #1D273D;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .cta:hover { background: #3FF98F; }
  .cta.is-loading { opacity: .7; pointer-events: none; }
  .header-cta { min-height: 2.75rem; padding-block: .65rem; }
  .hero { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 3rem; align-items: center; }
  .hero-title { margin: 0 0 1.25rem; color: #fff; font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; font-style: italic; text-transform: uppercase; line-height: 0.95; letter-spacing: -.035em; }
  .hero-title span { display: block; }
  .hero-title span + span { color: #00F573; }
  .hero-description { max-width: 31.25rem; margin: 0 0 1.75rem; color: rgba(255,255,255,.75); font-size: .9375rem; line-height: 1.65; }
  .hero .eyebrow { color: rgba(255,255,255,.55); }
  .contact-title { max-width: 30rem; margin: 0 0 1rem; color: #0A0A0C; font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.15; letter-spacing: -.03em; text-wrap: balance; }

  .barber-photo { width: 100%; max-width: 480px; margin: 0 auto; }
  .barber-photo img { display: block; width: 100%; height: auto; border: 1px solid #E4E6EB; border-radius: .625rem; }
  .barber-photo figcaption { margin-top: .75rem; padding-left: .75rem; border-left: 2px solid #00F573; color: rgba(255,255,255,.55); font-size: .75rem; line-height: 1.55; }

  @media (min-width: 640px) {
    .hero-description { font-size: 1rem; }
  }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0,1fr) 440px; gap: 2rem; }
  }

  @media (min-width: 1200px) {
    .hero-grid { grid-template-columns: minmax(0,1fr) 480px; gap: 3rem; }
  }

  .problem-list { max-width: 48rem; margin: 0; padding: 0; list-style: none; }
  .problem-list li { display: grid; grid-template-columns: 2.25rem minmax(0,1fr); gap: 1rem; align-items: center; padding: 1.25rem 0; border-top: 1px solid #DCDCE2; }
  .problem-list li > span { color: #00C45C; font-size: .8125rem; font-weight: 700; line-height: 1.6; }
  .problem-list h3, .benefit-row h3 { margin: 0 0 .3rem; font-size: .9375rem; font-weight: 600; line-height: 1.45; letter-spacing: -.01em; }
  .problem-list p, .benefit-row p { margin: 0; color: #62626E; font-size: .84375rem; line-height: 1.6; }
  .problem-list h3 { font-size: 1rem; }

  .benefits-grid { display: grid; grid-template-columns: minmax(0,1fr); gap: 2.5rem; }
  .benefits-intro, .benefit-list { min-width: 0; }
  .benefit-list { border-top: 1px solid #E4E6EB; }
  .benefit-row { display: grid; grid-template-columns: 4.75rem minmax(0,1fr); gap: 1rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid #E4E6EB; }
  .benefit-row img { width: 4.75rem; height: 4.75rem; object-fit: contain; }
  .benefit-row h3 { color: #0A0A0C; }
  .benefit-row p { color: #62626E; }

  .process-intro { margin-inline: auto; text-align: center; }
  .process-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process-list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1.25rem 1.35rem;
    border: 1px solid #E4E6EB;
    border-radius: 1rem;
    background: #fff;
  }
  .process-list img { width: 6.5rem; height: 6.5rem; object-fit: contain; margin-bottom: .75rem; }
  .process-list li > span { color: #00C45C; font-size: .75rem; font-weight: 700; letter-spacing: .08em; }
  .process-list h3 { margin: .35rem 0 .3rem; font-size: 1rem; font-weight: 700; line-height: 1.35; letter-spacing: -.01em; }
  .process-list p { margin: 0; max-width: 18rem; color: #62626E; font-size: .84375rem; line-height: 1.6; }
  .process-note { margin: 1.5rem 0 0; text-align: center; color: #62626E; font-size: .84375rem; line-height: 1.6; }

  @media (min-width: 768px) {
    .process-list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  }

  .faq-item summary { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 0; list-style: none; cursor: pointer; font-size: .9375rem; font-weight: 600; line-height: 1.5; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary span:last-child { transform: rotate(45deg); }
  .faq-item summary span:last-child { color: #00C45C; font-size: 1.25rem; transition: transform .15s ease; }
  .faq-item > p { max-width: 36rem; margin: 0; padding: 0 0 1.25rem; color: #62626E; font-size: .875rem; line-height: 1.65; }
  .faq-item > p a { color: #00C45C; font-weight: 600; text-decoration: none; }
  .faq-item > p a:hover { text-decoration: underline; }

  .status-option input:checked ~ .status-pill { border-color: #00C45C; background: #ECFFF4; color: #00C45C; }
  .status-option input:focus-visible ~ .status-pill { outline: 2px solid #00C45C; outline-offset: 2px; }
  .field { display: flex; flex-direction: column; gap: .4rem; color: #62626E; font-size: .6875rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
  .field input, .field textarea { width: 100%; min-height: 3rem; padding: .75rem .85rem; border: 1px solid #E4E4E9; border-radius: .5rem; background: #F4F5F7; color: #0A0A0C; font-family: inherit; font-size: .875rem; font-weight: 400; line-height: 1.5; text-transform: none; outline: none; resize: vertical; }
  .field input:focus, .field textarea:focus { border-color: #00C45C; background: #fff; }
  .field input.is-invalid, .field textarea.is-invalid { border-color: #FDA4AF; }
  .privacy { display: flex; align-items: flex-start; gap: .65rem; color: #88888F; font-size: .71875rem; line-height: 1.55; cursor: pointer; }
  .privacy input { width: 1rem; height: 1rem; margin-top: .1rem; accent-color: #00C45C; flex-shrink: 0; }
  .privacy a { color: #00C45C; text-decoration: underline; }

  @media (max-width: 639px) {
    .hero-cta { width: 100%; }
  }

  @media (min-width: 1024px) {
    .benefits-grid { grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 5rem; }
    .benefits-intro { position: sticky; top: 7rem; align-self: start; margin-bottom: 0; }
  }
</style>

<script>
  const mobileCta = document.getElementById('mobile-cta');
  const hero = document.querySelector('main section');
  const kontakt = document.getElementById('kontakt');
  let heroVisible = true;
  let kontaktVisible = false;
  const updateCta = () => mobileCta?.classList.toggle('translate-y-full', heroVisible || kontaktVisible);
  if (hero) new IntersectionObserver(entries => { heroVisible = entries[0].isIntersecting; updateCta(); }, { threshold: .15 }).observe(hero);
  if (kontakt) new IntersectionObserver(entries => { kontaktVisible = entries[0].isIntersecting; updateCta(); }, { threshold: .1 }).observe(kontakt);

  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const submit = document.getElementById('lead-submit') as HTMLButtonElement | null;
  const error = document.getElementById('lead-error');
  const params = new URLSearchParams(window.location.search);
  const fillHidden = (name: string, value: string) => {
    const field = form?.elements.namedItem(name) as HTMLInputElement | null;
    if (field && !field.value && value) field.value = value.slice(0, 60);
  };
  fillHidden('stadt', params.get('stadt') ?? params.get('city') ?? '');
  fillHidden('kampagne', params.get('utm_campaign') ?? params.get('kampagne') ?? '');
  fillHidden('utm_source', params.get('utm_source') ?? '');
  fillHidden('utm_medium', params.get('utm_medium') ?? '');

  const showError = (message: string) => {
    if (!error) return;
    error.textContent = message;
    error.classList.remove('hidden');
  };

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    error?.classList.add('hidden');
    let valid = true;

    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(field => {
      field.classList.remove('is-invalid');
      if (!field.checkValidity()) {
        field.classList.add('is-invalid');
        valid = false;
      }
    });

    if (!valid) {
      showError('Bitte füllen Sie alle Pflichtfelder aus und akzeptieren Sie die Datenschutzerklärung.');
      form.querySelector<HTMLElement>('.is-invalid')?.focus();
      return;
    }

    const data: Record<string, string> = {};
    new FormData(form).forEach((value, key) => { data[key] = value.toString(); });
    data.datenschutz = 'true';
    submit?.classList.add('is-loading');
    submit?.setAttribute('aria-busy', 'true');

    try {
      const response = await fetch('/api/barbershops', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) throw new Error(result.error ?? 'Unbekannter Fehler');
      const params = new URLSearchParams({ name: data.name ?? '', email: data.email ?? '' });
      window.location.href = `/danke?${params.toString()}`;
    } catch (cause) {
      submit?.classList.remove('is-loading');
      submit?.removeAttribute('aria-busy');
      showError(cause instanceof Error ? cause.message : 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut.');
    }
  });
</script>

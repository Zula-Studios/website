  }

  .hero-title {
    font-size: clamp(2rem, 3.5vw, 2.875rem);
    line-height: 1.14;
    overflow-wrap: normal;
    word-break: normal;
  }
  .hero-title-line { display: block; }

  @media (min-width: 1024px) {
    .hero-title-line { white-space: nowrap; }
  }

  .hero-section {
    padding-block: clamp(3.75rem, 7vw, 6rem);
  }

  @media (max-width: 389px) {
    .hero-cta { font-size: 0.875rem; }
    .hero-cta svg { display: none; }
  }

  @media (max-width: 359px) {
    .hero-title { font-size: 1.875rem; line-height: 1.16; }
  }
</style>

<script>
  // ── Sticky Mobile-CTA: erst nach dem Hero einblenden, beim Formular ausblenden ──
  const mobileCta = document.getElementById('mobile-cta');
  const heroSection = document.querySelector('main section');
  const kontaktSection = document.getElementById('kontakt');
  let heroVisible = true;
  let kontaktVisible = false;

  function updateMobileCta() {
    const show = !heroVisible && !kontaktVisible;
    mobileCta?.classList.toggle('translate-y-full', !show);
  }
  if (heroSection) {
    new IntersectionObserver(es => { heroVisible = es[0].isIntersecting; updateMobileCta(); }, { threshold: 0.15 }).observe(heroSection);
  }
  if (kontaktSection) {
    new IntersectionObserver(es => { kontaktVisible = es[0].isIntersecting; updateMobileCta(); }, { threshold: 0.1 }).observe(kontaktSection);
  }

  // ── "Webseiten-Analyse"-CTA: Status auf "hat-webseite" vorauswählen ────
  document.querySelectorAll('a[data-analyse]').forEach(a => {
    a.addEventListener('click', () => {
      const radio = document.querySelector<HTMLInputElement>('input[name="status"][value="hat-webseite"]');
      if (radio) radio.checked = true;
    });
  });

  // ── Formular-Submit ────────────────────────────────────────────────────
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('lead-submit') as HTMLButtonElement | null;
  const errorEl = document.getElementById('lead-error');

  function showError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl?.classList.add('hidden');

    // Validierung mit sichtbarem Feedback
    let valid = true;
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('.lp-input').forEach(el => {
      el.classList.remove('is-invalid');
      if (!el.checkValidity()) {
        el.classList.add('is-invalid');
        valid = false;
      }
    });
    const cb = document.getElementById('lead-datenschutz') as HTMLInputElement | null;
    if (!cb?.checked) valid = false;

    if (!valid) {
      showError('Bitte füllen Sie alle Pflichtfelder aus und akzeptieren Sie die Datenschutzerklärung.');
      form.querySelector<HTMLElement>('.is-invalid')?.focus();
      return;
    }

    const fd = new FormData(form);
    const data: Record<string, string> = {};
    fd.forEach((v, k) => { data[k] = v.toString(); });
    data['datenschutz'] = 'true';

    submitBtn?.classList.add('is-loading');
    submitBtn?.setAttribute('aria-busy', 'true');

    try {
      const res = await fetch('/api/gebaeudereinigung', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();

      if (res.ok && json.ok) {
        // Meta Pixel Lead-Event (nur wenn Pixel aktiv + Einwilligung erteilt)
        // @ts-expect-error fbq wird ggf. extern geladen
        if (typeof fbq !== 'undefined') fbq('track', 'Lead');
        const params = new URLSearchParams({ name: data['name'] ?? '', email: data['email'] ?? '' });
        window.location.href = `/danke?${params.toString()}`;
      } else {
        throw new Error(json.error ?? 'Unbekannter Fehler');
      }
    } catch (err) {
      submitBtn?.classList.remove('is-loading');
      submitBtn?.removeAttribute('aria-busy');
      showError(
        err instanceof Error && err.message
          ? err.message
          : 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder schreiben Sie uns direkt an hello@zulastudios.com.'
      );
    }
  });

  // ── META PIXEL (Platzhalter, DSGVO-konform) ────────────────────────────
  // Aktivieren: YOUR_PIXEL_ID ersetzen und den Block einkommentieren.
  // Der Code lädt erst NACH Einwilligung über das Consent-Banner.
  //
  // document.addEventListener('zula:consent', (e) => {
  //   if ((e as CustomEvent).detail !== 'accepted') return;
  //   if (typeof fbq !== 'undefined') return; // bereits geladen
  //   !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  //   n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
  //   n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
  //   t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
  //   document,'script','https://connect.facebook.net/en_US/fbevents.js');
  //   fbq('init', 'YOUR_PIXEL_ID');
  //   fbq('track', 'PageView');
  // });
</script>

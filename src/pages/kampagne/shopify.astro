---
/**
 * Meta Ads Lead-Generation Landing Page
 * URL: /kampagne/shopify
 * Color scheme: light surfaces + #00F573 / #00C45C accent
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { SITE } from '@/config/site';
import Icon from '@/components/Icon.astro';
import { faqPageSchema, serviceSchema } from '@/lib/schema';
import { projekte } from '@/data/projekte';

const referenzenCases = projekte.filter(
  p => p.tags.includes('Shopify') || p.serviceType === 'shop' || p.serviceType === 'migration',
).slice(0, 3);

const results = [
  { value: '+18 %',  label: 'Conversion Rate'         },
  { value: '-71 %',  label: 'Ladezeit'                },
  { value: '0',      label: 'Tage Downtime'           },
  { value: '+105 %', label: 'Organischer Traffic'     },
  { value: '98 %',   label: 'Kundenzufriedenheit'     },
  { value: '10+',   label: 'Projekte abgeschlossen'  },
];

const painPoints = [
  { pain: 'Ihr WooCommerce-Shop ist langsam und verliert täglich Kunden',   fix: 'Shopify lädt in unter 2 Sekunden – auch mit tausenden Produkten.' },
  { pain: 'Technische Probleme fressen Ihre Zeit statt Ihres Umsatzes',     fix: 'Shopify übernimmt Hosting, Sicherheit und Updates automatisch.' },
  { pain: 'Ihr Shop sieht generisch aus und spiegelt Ihre Marke nicht wider', fix: 'Custom Themes, die zu 100 % Ihre Identität widerspiegeln.' },
  { pain: 'Integrationen und Plugins funktionieren nicht zuverlässig',      fix: 'Native Shopify Apps + eigene Custom-Entwicklung für jeden Bedarf.' },
];

const steps = [
  { n: '01', title: 'Kostenloses Erstgespräch',  desc: 'In 30 Minuten analysieren wir Ihre Situation und zeigen Ihnen konkrete Möglichkeiten.', icon: '/images/body/body-talk.jpg' },
  { n: '02', title: 'Maßgeschneidertes Konzept', desc: 'Sie erhalten ein individuelles Konzept mit klarem Zeitplan und transparenter Preisübersicht.', icon: '/images/body/body-plan.jpg' },
  { n: '03', title: 'Entwicklung & Launch',       desc: 'Wir entwickeln agil, mit wöchentlichen Updates – und begleiten Sie über den Launch hinaus.', icon: '/images/body/body-launch.jpg' },
];

const faqs = [
  { q: 'Verliere ich meine SEO-Rankings bei einer Migration?',
    a: 'Nein – wenn die Migration professionell durchgeführt wird. Wir setzen vollständige 301-Redirects, erhalten alle Metadaten und validieren die Ergebnisse in der Google Search Console.' },
  { q: 'Wie lange dauert die Entwicklung?',
    a: 'Einfache Shops: 3–6 Wochen. Migrationen: 2–8 Wochen je nach Datenmenge. Custom-Projekte nach Briefing. Alle Zeitpläne werden vertraglich festgelegt.' },
  { q: 'Bekomme ich Support nach dem Launch?',
    a: 'Ja. Jedes Projekt beinhaltet 60 Tage kostenlosen Post-Launch-Support. Danach bieten wir flexible Retainer-Pakete an.' },
  { q: 'Arbeitet ihr auch mit bestehenden Shopify-Shops?',
    a: 'Absolut. Ob Redesign, App-Entwicklung, Performance-Audit oder Conversion-Optimierung – wir übernehmen Shopify-Projekte jeder Größe.' },
  { q: 'Warum eine Shopify-Agentur aus Hamburg?',
    a: 'Wir sitzen in Hamburg, arbeiten remote deutschlandweit und kennen den lokalen Markt. Persönliche Beratung, klare Prozesse und technische Umsetzung aus einer Hand.' },
];

const lpSchema = [
  serviceSchema({
    name: 'Shopify Entwicklung & Migration Hamburg',
    description:
      'Shopify-Shops, WooCommerce-Migrationen und Custom-Entwicklung für E-Commerce-Unternehmen – Zula Studios, Shopify Agentur in Hamburg.',
    serviceType: 'Shopify development',
    url: `${SITE.url}/kampagne/shopify`,
  }),
  faqPageSchema(faqs),
];
---

<LandingLayout
  title="Shopify Agentur Hamburg – Shop, Migration & Entwicklung"
  description="Shopify Agentur in Hamburg: neue Shops, WooCommerce-Migration ohne Downtime, Custom Themes & Apps. Laravel, Next.js & Astro. Kostenloses Erstgespräch."
  noindex={true}
  schema={lpSchema}
>

  <!-- META PIXEL — uncomment + replace YOUR_PIXEL_ID -->
  <!--
  <script>!function(f,b,e,v,n,t,s){...}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init','YOUR_PIXEL_ID');fbq('track','PageView');</script>
  <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=YOUR_PIXEL_ID&ev=PageView&noscript=1"/></noscript>
  -->

  <!-- ══════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════ -->
  <section class="relative bg-[#0A0A0C] overflow-hidden">
    <div class="container relative z-10 py-14 lg:py-20">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_440px] gap-10 lg:gap-16 items-center">

        <div>
          <h1
            class="font-extrabold italic uppercase text-white tracking-[-0.035em] mb-6"
            style="font-size: clamp(2.35rem, 5vw, 4.1rem); line-height: 0.92;"
          >
            Shopify aus<br />Hamburg.<br />
            <span class="text-[#00F573]">Shops, die verkaufen.</span>
          </h1>

          <p class="text-white/75 text-[15px] lg:text-base leading-relaxed mb-8 max-w-[480px]">
            Neue Shops, WooCommerce-Migrationen ohne Downtime und Custom-Entwicklung mit Laravel, Next.js und Astro. Feste Ansprechpartner, 10+ abgeschlossene Projekte.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6">
            {[
              'Shopify-zertifizierte Entwickler',
              '0 Tage Downtime — garantiert',
              'Antwort innerhalb von 24 Stunden',
              'Kein Verkaufsdruck, kein Risiko',
            ].map(t => (
              <div class="flex items-center gap-2.5 text-[13px] text-white/75">
                <div class="w-5 h-5 rounded-full flex items-center justify-center shrink-0 bg-[#00F573]/20">
                  <Icon name="check" size={11} class="shrink-0 text-[#00F573]" strokeWidth={2.5} />
                </div>
                {t}
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Lead form -->
        <div id="lead-form-top" style="animation: fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) 0.18s both">
          <!-- Yellow top accent stripe -->
          <div class="h-1 rounded-t-2xl" style="background: linear-gradient(90deg, #00F573, #00C45C);"></div>
          <div class="bg-white rounded-b-2xl border border-[#E4E6EB] border-t-0 shadow-[0_20px_50px_rgba(10,10,12,0.08)] px-7 pt-7 pb-8 lg:px-9 lg:pt-8 lg:pb-9">

            <div class="mb-6">
              <h2 class="font-bold text-[#0A0A0C] text-[18px] tracking-[-0.02em] mb-1">
                Jetzt kostenlos anfragen
              </h2>
              <p class="text-[#AEAEB5] text-xs">Unverbindlich · Antwort in 24 Std. · Kein Spam</p>
            </div>

            <!-- Service quick-select pills -->
            <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2 mb-6">
              {[
                { value: 'neuer-shop',  label: 'Neuer Shop'       },
                { value: 'migration',   label: 'Migration'        },
                { value: 'custom-app',  label: 'Custom App'       },
                { value: 'laravel-next',label: 'Laravel / Next.js'},
                { value: 'sonstiges',   label: 'Sonstiges'        },
              ].map((s, i) => (
                <label class="quick-pill cursor-pointer">
                  <input type="radio" name="service_quick" value={s.value} class="sr-only" checked={i === 0} />
                  <div class="pill-label w-full text-center rounded-full border border-[#EBEBEF] px-3.5 py-1.5 text-[12px] font-semibold text-[#88888F] transition-all duration-150 select-none">
                    {s.label}
                  </div>
                </label>
              ))}
            </div>

            <form name="meta-lead" method="POST" action="/danke" class="space-y-3" id="hero-form">
              <input type="hidden" name="service" id="service-hidden" value="neuer-shop" />
              <input type="hidden" name="source" value="meta-ads-hero" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="lp-field">
                  <input type="text" name="vorname" placeholder=" " required autocomplete="given-name" class="lp-input" />
                  <label class="lp-label">Vorname *</label>
                </div>
                <div class="lp-field">
                  <input type="text" name="nachname" placeholder=" " required autocomplete="family-name" class="lp-input" />
                  <label class="lp-label">Nachname *</label>
                </div>
              </div>

              <div class="lp-field">
                <input type="email" name="email" placeholder=" " required autocomplete="email" class="lp-input" />
                <label class="lp-label">E-Mail-Adresse *</label>
              </div>

              <div class="lp-field">
                <input type="tel" name="telefon" placeholder=" " autocomplete="tel" class="lp-input" />
                <label class="lp-label">Telefon (für Rückruf)</label>
              </div>

              <button type="submit" class="lp-cta-btn w-full mt-1">
                Jetzt kostenlos anfragen
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <p class="text-center text-[10.5px] text-[#D4D4D9] pt-0.5">
                <a href="/datenschutz" class="underline underline-offset-2 hover:text-[#AEAEB5] transition-colors">Datenschutzerklärung</a> · DSGVO-konform
              </p>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       TRUST BAR
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white border-y border-[#E4E6EB]">
    <div class="container">
      <div class="grid grid-cols-3 lg:grid-cols-6 divide-x divide-[#E4E6EB]">
        {results.map(r => (
          <div class="px-5 py-7 text-center">
            <div class="font-bold text-[22px] tracking-[-0.04em] leading-none mb-1.5" style="color: #00F573;">{r.value}</div>
            <div class="text-[#9898A0] text-[11px] leading-tight">{r.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       PAIN → SOLUTION
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 lg:py-28 border-y border-[#E4E6EB]">
    <div class="container">

      <!-- Header -->
      <div class="max-w-2xl mx-auto text-center mb-14" data-reveal>
        <p class="label text-[#9898A0] mb-3">Kennen Sie das?</p>
        <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          Probleme, die Sie täglich Umsatz kosten
        </h2>
      </div>

      <!-- Column labels (desktop) -->
      <div class="hidden lg:grid grid-cols-[1fr_56px_1fr] max-w-4xl mx-auto mb-3 px-1">
        <div class="flex items-center gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#6E3030]">Das Problem</span>
        </div>
        <div></div>
        <div class="flex items-center gap-2.5">
          <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#00F573;"></span>
          <span class="text-[11px] font-bold uppercase tracking-[0.14em]" style="color:#00C45C;">Die Lösung</span>
        </div>
      </div>

      <!-- Rows -->
      <div class="max-w-4xl mx-auto divide-y divide-[#E4E6EB]" data-reveal data-delay="1">
        {painPoints.map((p, i) => (
          <div class="grid grid-cols-1 lg:grid-cols-[1fr_56px_1fr] items-center gap-4 py-6">

            <!-- Pain -->
            <div class="flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full border border-red-900/60 bg-[#1C0A0A] flex items-center justify-center shrink-0 mt-0.5">
                <svg width="8" height="8" viewBox="0 0 10 10" fill="none">
                  <path d="M2 2l6 6M8 2L2 8" stroke="#F87171" stroke-width="1.75" stroke-linecap="round"/>
                </svg>
              </div>
              <p class="text-[#62626E] text-[14px] leading-relaxed">{p.pain}</p>
            </div>

            <!-- Arrow connector -->
            <div class="hidden lg:flex items-center justify-center">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4 10h12M11 5l5 5-5 5" stroke="#3E3E4A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <!-- Mobile: subtle separator -->
            <div class="lg:hidden flex items-center gap-3 pl-9.5">
              <div class="flex-1 h-px bg-[#E4E6EB]"></div>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M7 2v10M2 8l5 5 5-5" stroke="#3E3E4A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <div class="flex-1 h-px bg-[#E4E6EB]"></div>
            </div>

            <!-- Solution -->
            <div class="flex items-start gap-3.5">
              <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background: rgba(0,245,115,0.12); border: 1px solid rgba(0,196,92,0.25);">
                <Icon name="check" size={10} strokeWidth={2.75} style="color: #00C45C;" />
              </div>
              <p class="text-[#0A0A0C] text-[14px] leading-relaxed font-medium">{p.fix}</p>
            </div>

          </div>
        ))}
      </div>

      <!-- CTA -->
      <div class="text-center mt-12" data-reveal>
        <a href="#lead-form-bottom" class="lp-cta-btn inline-flex px-9 py-4 text-[15px]">
          Kostenloses Erstgespräch sichern
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       HOW IT WORKS
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 relative overflow-hidden">
    <div class="container relative z-10">
      <div class="max-w-xl mx-auto text-center mb-14" data-reveal>
        <p class="label mb-3">So einfach geht's</p>
        <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1;">
          In 3 Schritten zu Ihrem Shopify-Shop
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 max-w-4xl mx-auto">
        {steps.map((s, i) => (
          <div class="relative rounded-2xl border border-[#E4E6EB] bg-white p-8 hover:border-[#00C45C]/40 transition-colors shadow-sm" data-reveal data-delay={String(i + 1)}>
            {i < 2 && (
              <div class="hidden lg:block absolute top-10 -right-2.5 z-10 opacity-30">
                <svg width="20" height="20" viewBox="0 0 14 14" fill="none">
                  <path d="M1 7h12M8 2l5 5-5 5" stroke="#0A0A0C" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            )}
            <img src={s.icon} alt="" width="160" height="160" class="w-28 h-28 object-contain mb-5" loading="lazy" decoding="async" />
            <div class="font-black text-5xl tracking-[-0.05em] leading-none mb-6 select-none" style="color: #00C45C; opacity: 0.9;">{s.n}</div>
            <h3 class="font-bold text-[#0A0A0C] text-[15px] mb-2.5 tracking-[-0.01em]">{s.title}</h3>
            <p class="text-[#62626E] text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       REFERENZEN
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 lg:py-28">
    <div class="container">
      <div class="max-w-xl mx-auto text-center mb-14" data-reveal>
        <p class="label mb-3">Referenzen</p>
        <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
          Echte Shopify-Projekte aus unserer Arbeit
        </h2>
        <p class="text-[#62626E] text-sm mt-4 max-w-md mx-auto">
          Keine erfundenen Bewertungen – hier sehen Sie ausgewählte Cases mit Zahlen und Ergebnissen.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {referenzenCases.map((projekt, i) => (
          <a
            href={`/referenzen/${projekt.slug}`}
            class="group flex flex-col bg-[#FAFAF8] border border-[#EBEBEF] rounded-2xl p-7 lg:p-8 transition-colors hover:border-[#00F573]/50 hover:shadow-md no-underline"
            data-reveal
            data-delay={String(i + 1)}
          >
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-xl text-white text-[11px] font-bold flex items-center justify-center shrink-0"
                style={`background: ${projekt.cardBg};`}
              >
                {projekt.clientKurz}
              </div>
              <div>
                <div class="font-semibold text-[#0A0A0C] text-[14px] group-hover:text-[#00C45C] transition-colors">{projekt.client}</div>
                <div class="text-[#AEAEB5] text-[11px]">{projekt.industry} · {projekt.jahr}</div>
              </div>
            </div>

            <p class="text-[#44444F] text-sm leading-relaxed mb-5 flex-grow">{projekt.tagline}</p>

            <div class="grid grid-cols-2 gap-2 mb-5">
              {projekt.metrics.slice(0, 2).map(m => (
                <div class="rounded-lg bg-white border border-[#EBEBEF] px-2.5 py-2 text-center">
                  <div class="font-bold text-[#0A0A0C] text-[13px]">{m.value}</div>
                  <div class="text-[#AEAEB5] text-[10px] leading-tight">{m.label}</div>
                </div>
              ))}
            </div>

            <span class="text-[13px] font-semibold text-[#00C45C] inline-flex items-center gap-1.5 mt-auto">
              Case Study lesen
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        ))}
      </div>

      <p class="text-center mt-10" data-reveal>
        <a href="/referenzen" class="text-[14px] font-semibold text-[#62626E] hover:text-[#0A0A0C] underline underline-offset-4 transition-colors">
          Alle Referenzen ansehen
        </a>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       FAQ
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-[#FAFAF8] border-t border-[#EBEBEF] py-20 lg:py-28">
    <div class="container max-w-3xl">
      <div class="max-w-xl mx-auto text-center mb-14" data-reveal>
        <p class="label mb-3">Häufige Fragen</p>
        <h2 class="font-bold text-[#0A0A0C] tracking-[-0.03em]" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.1;">
          Ihre Fragen — unsere Antworten
        </h2>
      </div>

      <div class="space-y-3" data-reveal data-delay="1">
        {faqs.map(faq => (
          <details class="faq-item bg-white border border-[#EBEBEF] rounded-2xl overflow-hidden group">
            <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer select-none">
              <span class="font-semibold text-[#0A0A0C] text-[14.5px] leading-snug">{faq.q}</span>
              <div class="faq-icon w-8 h-8 rounded-xl border border-[#EBEBEF] flex items-center justify-center shrink-0 transition-all duration-200">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" class="faq-chevron transition-transform duration-200">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </summary>
            <div class="px-6 pb-6">
              <p class="text-[#62626E] text-sm leading-relaxed border-t border-[#F5F5F8] pt-4">{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       BOTTOM CTA — dark with second form
  ══════════════════════════════════════════════════════════ -->
  <section class="bg-[#F4F5F7] py-20 lg:py-28 relative overflow-hidden" id="lead-form-bottom">
    <!-- Yellow glow bottom -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] pointer-events-none" style="background: radial-gradient(ellipse at 50% 100%, rgba(0,245,115,0.1), transparent 60%);"></div>

    <div class="container relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_440px] gap-12 lg:gap-20 items-center">

        <!-- Left copy -->
        <div data-reveal>
          <p class="label mb-5">Jetzt starten</p>
          <h2 class="font-bold text-[#0A0A0C] tracking-[-0.04em] mb-6" style="font-size: clamp(2rem, 5vw, 3.75rem); line-height: 0.95;">
            Ihr nächster<br/>
            <span style="color: #00C45C;">Shopify-Shop</span><br/>
            fängt hier an.
          </h2>
          <p class="text-[#62626E] text-base leading-relaxed mb-8 max-w-md">
            Kein Verkaufsdruck, kein Risiko. Nur ein ehrliches Gespräch darüber, wie wir Ihren Shop auf das nächste Level bringen.
          </p>
          <div class="space-y-3.5">
            {[
              'Kostenlos & unverbindlich',
              'Antwort innerhalb von 24 Stunden',
              'Kein Minimalbudget für die Anfrage',
            ].map(item => (
              <div class="flex items-center gap-3 text-[13.5px] text-[#62626E]">
                <div class="w-6 h-6 rounded-lg flex items-center justify-center shrink-0" style="background: rgba(0,245,115,0.12);">
                  <Icon name="check" size={12} strokeWidth={2.5} style="color: #00C45C;" />
                </div>
                {item}
              </div>
            ))}
          </div>
        </div>

        <!-- Right: second form -->
        <div data-reveal data-delay="2">
          <div class="h-1 rounded-t-2xl" style="background: linear-gradient(90deg, #00F573, #00C45C);"></div>

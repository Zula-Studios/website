---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  publishedDate: string;
  modifiedDate?: string;
  author?: string;
  category?: string;
  tags?: string[];
  ogImage?: string;
  readingTime?: number;
  slug: string;
}

const {
  title,
  description,
  publishedDate,
  modifiedDate,
  author = 'Zula Studios Team',
  category,
  tags = [],
  ogImage,
  readingTime,
  slug,
} = Astro.props;

const breadcrumbs = [
  { name: 'Startseite', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: title, url: `/blog/${slug}` },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Person', name: author, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL(SITE.logo, SITE.url).toString() },
  },
  datePublished: publishedDate,
  dateModified: modifiedDate ?? publishedDate,
  image: ogImage ? new URL(ogImage, SITE.url).toString() : new URL(SITE.ogImage, SITE.url).toString(),
  url: new URL(`/blog/${slug}`, SITE.url).toString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL(`/blog/${slug}`, SITE.url).toString() },
};

const formattedDate = new Date(publishedDate).toLocaleDateString('de-DE', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  publishedDate={publishedDate}
  modifiedDate={modifiedDate}
  author={author}
  schema={articleSchema}
  breadcrumbs={breadcrumbs}
>
  <!-- Article header -->
  <div class="bg-[#0A0A0C] pt-24 lg:pt-28 overflow-hidden">
    <div class="container grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_240px] items-end gap-8 py-12 lg:py-16">
      <div class="max-w-2xl">
      <nav class="flex items-center gap-2 text-xs text-white/45 mb-8 flex-wrap">
        <a href="/" class="hover:text-white transition-colors">Startseite</a>
        <span>/</span>
        <a href="/blog" class="hover:text-white transition-colors">Blog</a>
        <span>/</span>
        <span class="text-white/70 truncate">{title}</span>
      </nav>

      {category && (
        <span class="inline-block text-[10.5px] font-bold uppercase tracking-wider text-[#0A0A0C] bg-[#00F573] px-2.5 py-1 rounded-md mb-5">
          {category}
        </span>
      )}

      <h1 class="font-extrabold italic text-white tracking-[-0.03em] mb-4 leading-tight" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        {title}
      </h1>

      <p class="text-white/75 text-base lg:text-lg leading-relaxed mb-7">{description}</p>

      <div class="flex flex-wrap items-center gap-4 text-xs text-white/50">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-[#00F573] text-[#0A0A0C] text-[10px] font-bold flex items-center justify-center">
            {author.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
          </div>
          <span class="font-medium text-white/80">{author}</span>
        </div>
        <span>·</span>
        <time datetime={publishedDate}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime} Min. Lesezeit</span>
          </>
        )}
      </div>

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-5">
          {tags.map(tag => (
            <span class="text-[11px] bg-white/10 text-white/70 px-2.5 py-1 rounded-lg">#{tag}</span>
          ))}
        </div>
      )}
      </div>
      <img src="/images/heroes/hero-blog.png" alt="" width="866" height="627" class="hidden lg:block w-full max-w-[240px] justify-self-end" decoding="async" />
    </div>
  </div>

  <!-- Article body -->
  <article class="py-14 lg:py-20">
    <div class="container max-w-2xl">
      <div class="prose prose-gray max-w-none
        prose-headings:font-bold prose-headings:tracking-tight
        prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:text-[#0C0C0F]
        prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-[#0C0C0F]
        prose-p:text-[#44444F] prose-p:leading-relaxed prose-p:text-[15.5px]
        prose-a:text-accent-600 prose-a:no-underline hover:prose-a:underline
        prose-strong:text-[#0C0C0F] prose-strong:font-semibold
        prose-ul:text-[#44444F] prose-ol:text-[#44444F]
        prose-li:my-1.5 prose-li:text-[15.5px]
        prose-table:text-sm prose-th:text-[#0C0C0F]
      ">
        <slot />
      </div>
    </div>
  </article>

  <!-- Back to blog -->
  <div class="py-12 border-t border-[#EBEBEF]">
    <div class="container max-w-2xl">
      <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-[#62626E] hover:text-[#0C0C0F] transition-colors">
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
          <path d="M13 7H1M6 2L1 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Zurück zum Blog
      </a>
    </div>
  </div>
</BaseLayout>

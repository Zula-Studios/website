---
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  breadcrumbs?: { name: string; url: string }[];
  darkHero?: boolean;
}

const { darkHero = false, ...props } = Astro.props;
---

<!DOCTYPE html>
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="shortcut icon" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F5F7" />

    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
      />
    </noscript>
    <SEO {...props} />
    <style is:global>
      /* ── Design Tokens — DM-inspired agency system ── */
      :root {
        --ink: #0A0A0C;
        --ink-navy: #1D273D;
        --ink-muted: #62626E;
        --ink-subtle: #AEAEB5;
        --surface-warm: #F4F5F7;
        --border: #E4E6EB;
        --accent: #00F573;
        --accent-hover: #00C45C;
        --accent-ink: #1D273D;
        --accent-light: #ECFFF4;
        --contrast-violet: #7C3AED;
        --contrast-emerald: #00F573;
        --contrast-coral: #EA580C;
        --contrast-amber: #D97706;
        --radius: 0.75rem;
        --radius-pill: 9999px;
        --transition: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* ── Base ── */
      *, *::before, *::after { box-sizing: border-box; }

      html { font-feature-settings: 'ss01' on; }

      body {
        font-family: 'Outfit', system-ui, sans-serif;
        color: var(--ink);
        background: #ffffff;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
      }

      /* ── Selection ── */
      ::selection {
        background: #00F573;
        color: #1D273D;
      }

      /* ── Scrollbar ── */
      ::-webkit-scrollbar { width: 5px; }
      ::-webkit-scrollbar-track { background: transparent; }
      ::-webkit-scrollbar-thumb { background: #D4D4D9; border-radius: 10px; }
      ::-webkit-scrollbar-thumb:hover { background: #AEAEB5; }

      /* ── Focus ── */
      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 4px;
      }

      /* ── Container ── */
      .container {
        max-width: 1240px;
        margin-left: auto;
        margin-right: auto;
        padding-left: 1.25rem;
        padding-right: 1.25rem;
      }
      @media (min-width: 640px) {
        .container { padding-left: 2rem; padding-right: 2rem; }
      }
      @media (min-width: 1024px) {
        .container { padding-left: 2.5rem; padding-right: 2.5rem; }
      }

      /* ── Section Label ── */
      .label {
        display: inline-block;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-subtle);
      }

      .section-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        max-width: 100%;
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-wrap: balance;
        text-align: center;
      }
      @media (min-width: 640px) {
        .section-label { letter-spacing: 0.18em; }
      }
      .section-label::before,
      .section-label::after {
        content: '';
        width: 1.25rem;
        height: 1px;
        flex-shrink: 0;
        opacity: 0.65;
        background: currentColor;
      }
      .section-label--blue,
      .section-label--violet,
      .section-label--emerald,
      .section-label--coral,
      .section-label--amber { color: #00C45C; }

      .chip-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 0.625rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      @media (min-width: 480px) {
        .chip-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      }
      @media (min-width: 1024px) {
        .chip-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
      }
      .chip {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.65rem 0.85rem;
        border-radius: 0.75rem;
        border: 1px solid #EBEBEF;
        background: #FAFAF8;
        color: #44444F;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.3;
        text-align: center;
      }
      .chip--accent {
        border-color: #C6F9D8;
        background: #ECFFF4;
        color: #00C45C;
      }

      /* ── Ambient orbs (DM-style) ── */
      .hero-glow::before,
      .hero-glow::after,
      .cta-glow::before {
        content: '';
        position: absolute;
        pointer-events: none;
        border-radius: 50%;
        filter: blur(2px);
      }
      .hero-glow::before {
        top: -8%;
        right: -5%;
        width: min(520px, 72vw);
        height: min(520px, 72vw);
        background: radial-gradient(circle, rgba(0,245,115,0.28) 0%, rgba(0,245,115,0.06) 45%, transparent 70%);
        animation: orbFloat 14s ease-in-out infinite;
      }
      .hero-glow::after {
        bottom: -10%;
        left: -8%;
        width: min(420px, 60vw);
        height: min(420px, 60vw);
        background: radial-gradient(circle, rgba(0,196,92,0.18) 0%, transparent 68%);
        animation: orbFloat 18s ease-in-out infinite reverse;
      }
      .cta-glow::before {
        inset: auto;
        bottom: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: min(700px, 90vw);
        height: min(400px, 50vw);
        background: radial-gradient(ellipse, rgba(0,245,115,0.22), transparent 70%);
        filter: blur(0);
      }
      @keyframes orbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-18px, 22px) scale(1.05); }
      }

      /* ── Icon chips & stat accents ── */
      .icon-chip {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.75rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
      }
      .icon-chip--blue { background: #ECFFF4; border-color: #B3FDD2; color: #00994D; }
      .icon-chip--violet { background: #ECFFF4; border-color: #B3FDD2; color: #00994D; }
      .icon-chip--emerald { background: #ECFFF4; border-color: #B3FDD2; color: #00994D; }
      .icon-chip--coral { background: #ECFFF4; border-color: #B3FDD2; color: #00994D; }
      .icon-chip--amber { background: #ECFFF4; border-color: #B3FDD2; color: #00994D; }

      .stat-accent {
        position: relative;
        overflow: hidden;
      }
      .stat-accent::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        opacity: 0.75;
      }
      .stat-accent--blue::before { background: #00F573; }
      .stat-accent--violet::before { background: #00F573; }
      .stat-accent--emerald::before { background: #00F573; }
      .stat-accent--amber::before { background: #00F573; }

      /* ── Scroll Progress Bar ── */
      #scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        width: 0%;
        background: linear-gradient(90deg, #00F573 0%, #00C45C 100%);
        z-index: 9999;
        transition: width 80ms linear;
        pointer-events: none;
      }

      /* ── Reveal Animations ── */
      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 0.65s var(--transition),
          transform 0.65s var(--transition);
        will-change: opacity, transform;
      }
      [data-reveal="fade"] { transform: none; }
      [data-reveal="left"] { transform: translateX(-18px); }
      [data-reveal="scale"] { transform: scale(0.97); }
      [data-reveal].visible {
        opacity: 1;
        transform: none;
      }
      [data-delay="1"] { transition-delay: 0.08s; }
      [data-delay="2"] { transition-delay: 0.16s; }
      [data-delay="3"] { transition-delay: 0.24s; }
      [data-delay="4"] { transition-delay: 0.32s; }
      [data-delay="5"] { transition-delay: 0.42s; }
      [data-delay="6"] { transition-delay: 0.52s; }

      /* ── Marquee ── */
      .marquee-track {
        display: flex;
        width: max-content;
        animation: marquee 32s linear infinite;
      }
      .marquee-track:hover { animation-play-state: paused; }
      @keyframes marquee {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      /* ── Smooth details/summary ── */
      details > summary { list-style: none; cursor: pointer; }
      details > summary::-webkit-details-marker { display: none; }

      /* ── Buttons — pill CTAs like agency reference ── */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.01em;
        padding: 0.8rem 1.6rem;
        border-radius: var(--radius-pill);
        transition: all 0.18s var(--transition);
        cursor: pointer;
        white-space: normal;
        text-align: center;
        text-decoration: none;
        border: none;
      }
      .btn:active { transform: scale(0.97); }
      .btn-primary {
        background: var(--accent);
        color: var(--accent-ink);
      }
      .btn-primary:hover { background: #3FF98F; color: var(--accent-ink); }
      .btn-ghost {
        background: transparent;
        color: rgba(255,255,255,0.85);
        border: 1.5px solid rgba(255,255,255,0.28);
      }
      .btn-ghost:hover {
        background: rgba(255,255,255,0.08);
        color: #ffffff;
        border-color: rgba(255,255,255,0.5);
      }
      .btn-outline {
        background: transparent;
        color: var(--ink);
        border: 1.5px solid var(--border);
      }
      .btn-outline:hover { border-color: var(--accent); background: var(--accent-light); }
      .btn-accent {
        background: var(--accent);
        color: var(--accent-ink);
      }
      .btn-accent:hover { background: #3FF98F; }
    </style>
  </head>
  <body data-hero={darkHero ? 'dark' : 'light'}>
    <div id="scroll-progress"></div>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <script>
      // ── Scroll Progress ──
      const progressBar = document.getElementById('scroll-progress');
      function updateProgress() {
        const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
        if (progressBar) progressBar.style.width = (scrolled * 100) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      // ── Reveal Animations ──
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));

      // Header scroll is handled in Header.astro
    </script>
  </body>
</html>

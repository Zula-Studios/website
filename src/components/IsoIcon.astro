---
interface Props {
  src: string;
  size?: 'sm' | 'md';
}
const { src, size = 'md' } = Astro.props;
const box = size === 'sm' ? 'w-12 h-12' : 'w-16 h-16';
---
<img
  src={src}
  alt=""
  width="160"
  height="160"
  class:list={[box, 'object-contain shrink-0']}
  loading="lazy"
  decoding="async"
/>
